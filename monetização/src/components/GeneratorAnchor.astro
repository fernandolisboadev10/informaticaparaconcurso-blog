---
import StudyOffer from './StudyOffer.astro';
---
<div class="generator-anchor" id="generator-anchor" data-interval="10000" hidden>
  <div class="anchor-content">
    <StudyOffer product="gerador" placement="rodape-flutuante" format="anchor" label="Começar grátis" />
    <button type="button" aria-label="Fechar banner do Gerador">×</button>
  </div>
</div>

<script>
  const banner = document.querySelector<HTMLElement>('#generator-anchor');
  if (banner) {
    const anchor = banner;
    const interval = Number(anchor.dataset.interval);
    const cookies = document.getElementById('cookie-banner');
    const quiz = document.getElementById('questoes');
    let quizInView = false;
    let nextAppearance = performance.now() + interval;
    let timer: number | undefined;

    function update() {
      window.clearTimeout(timer);
      if (document.hidden || quizInView || (cookies && !cookies.hidden)) {
        anchor.hidden = true;
        return;
      }
      const remaining = nextAppearance - performance.now();
      anchor.hidden = remaining > 0;
      if (remaining > 0) timer = window.setTimeout(update, remaining);
    }

    anchor.querySelector('button')?.addEventListener('click', () => {
      nextAppearance = performance.now() + interval;
      update();
    });
    if (cookies) new MutationObserver(update).observe(cookies, { attributes: true, attributeFilter: ['hidden'] });
    if (quiz && 'IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => {
        quizInView = entry.isIntersecting;
        update();
      }).observe(quiz);
    }
    document.addEventListener('visibilitychange', update);
    update();
  }
</script>

<style>
  .generator-anchor {
    position: fixed;
    inset-inline: 0;
    bottom: calc(8px + env(safe-area-inset-bottom, 0px));
    z-index: 39;
    width: min(620px, calc(100% - 20px));
    margin-inline: auto;
    border-radius: 14px;
    box-shadow: 0 6px 20px #030b1f38;
  }
  .generator-anchor button {
    position: absolute;
    inset-inline-end: 5px;
    top: 50%;
    translate: 0 -50%;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 8px;
    background: #203d53;
    color: #f6f8ff;
    font: 600 24px/1 var(--font-body);
    cursor: pointer;
  }
  .anchor-content { position: relative; margin-inline: auto; }
  .generator-anchor button:hover, .generator-anchor button:focus-visible { background: #314867; }
  :global(body:has(#generator-anchor:not([hidden]))) { padding-bottom: 104px; }
  :global(body:has(#generator-anchor:not([hidden])) #back-to-top) { bottom: calc(108px + env(safe-area-inset-bottom, 0px)); }
  @media (min-width: 1024px) {
    .generator-anchor {
      width: 100%;
      bottom: 0;
      padding-bottom: env(safe-area-inset-bottom, 0px);
      border-top: 1px solid #406171;
      border-radius: 0;
      background: #12283b;
    }
    .anchor-content { max-width: 860px; padding-inline: 12px; }
    .anchor-content :global(.study-offer.anchor) { border: 0; border-radius: 0; }
    .generator-anchor button { inset-inline-end: 17px; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .generator-anchor:not([hidden]) { animation: anchor-rise .4s cubic-bezier(.2,.8,.3,1) both; }
    @keyframes anchor-rise { from { translate: 0 110%; } }
  }
</style>
