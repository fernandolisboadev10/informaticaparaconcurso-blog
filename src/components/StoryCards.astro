---
import type { CollectionEntry } from 'astro:content';
import { storyHref } from '../utils/stories';

interface Props {
  stories: CollectionEntry<'stories'>[];
}

const { stories } = Astro.props;
---

<ul class="story-cards">
  {stories.map(({ id, data: { poster, title, pages } }) => (
    <li>
      <a href={storyHref(id)} class="story-card">
        <img src={poster.src} width={poster.width} height={poster.height} alt="" loading="lazy" decoding="async" />
        <div class="story-caption">
          <p>{title}</p>
          <span class="story-open">Abrir story <span aria-hidden="true">·</span> {pages.length + 2} telas</span>
        </div>
      </a>
    </li>
  ))}
</ul>

<style>
  .story-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(12rem, 100%), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .story-card {
    position: relative;
    display: grid;
    align-items: end;
    min-height: 15rem;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    isolation: isolate;
    border-radius: 1rem;
    border: 1px solid var(--line-strong);
    background: #121826;
    color: #fff;
    text-decoration: none;
  }

  .story-card:hover {
    border-color: var(--violet);
  }

  .story-card:focus-visible {
    outline: 3px solid var(--violet);
    outline-offset: 3px;
  }

  img {
    position: absolute;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .story-card::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(180deg, transparent 15%, #0b1425 93%);
    content: '';
  }

  .story-caption {
    padding: 1rem;
  }

  p {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 800;
    line-height: 1.2;
    text-wrap: balance;
  }

  .story-open {
    color: #99f6e4;
    font-size: 0.875rem;
    font-weight: 700;
  }
</style>
