---
interface Props { direction?: 'right' | 'down' | 'up' | 'diagonal'; }
const { direction = 'right' } = Astro.props;
const angle = { right: 0, down: 90, up: -90, diagonal: -45 }[direction];
---
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" style={`transform: rotate(${angle}deg); flex-shrink: 0; display: inline-block; vertical-align: middle;`}><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
