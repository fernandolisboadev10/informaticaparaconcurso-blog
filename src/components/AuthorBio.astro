---
import { socials } from '../data/socials';
---
<aside class="author-bio">
  <img
    src="/images/fernando-lisboa.png"
    alt="Fernando Lisboa"
    class="author-photo"
    width="72"
    height="72"
    loading="lazy"
  />
  <div class="author-body">
    <p class="author-name">Fernando Lisboa</p>
    <p>
      Professor de robótica e informática, especialista em inteligência
      artificial e redator do Informática para Concurso. Meu objetivo é
      ajudar concurseiros de todo o país com conteúdo gratuito, prático e
      atualizado.
    </p>
    <ul class="author-social" aria-label="Redes sociais de Fernando Lisboa">
      {socials.map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="noopener noreferrer me" aria-label={s.label} title={s.label}>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d={s.path} /></svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</aside>

<style>
  .author-bio {
    display: flex;
    gap: 16px;
    align-items: center;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .author-photo {
    flex-shrink: 0;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
  }

  .author-name {
    margin: 0 0 4px;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--ink-strong);
  }

  .author-body {
    min-width: 0;
  }

  @media (max-width: 600px) {
    .author-bio {
      align-items: flex-start;
    }
  }

  .author-social {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 14px 0 0;
    padding: 0;
  }

  .author-social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--ink-soft);
    transition: color 0.15s, border-color 0.15s;
  }

  .author-social a:hover,
  .author-social a:focus-visible {
    color: var(--ink-strong);
    border-color: var(--ink-soft);
  }

  .author-body p:not(.author-name) {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }
</style>
