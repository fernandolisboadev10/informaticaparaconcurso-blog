---
import { APOSTILA_URL, APOSTILA_PRICE, APOSTILA_QUESTIONS, APOSTILA_COVER, MODULO_BY_CATEGORY, apostilaAriaLabel } from '../data/apostila';

interface Props {
  slot: string; // identifica a posição no GA4: post-meio, post-fim, post-lateral, home, categoria
  variant?: 'wide' | 'side' | 'hero';
  category?: string;
}

const { slot, variant = 'wide', category } = Astro.props;
const modulo = category ? MODULO_BY_CATEGORY[category] : undefined;
const isHero = variant === 'hero';
const title = isHero
  ? `${APOSTILA_QUESTIONS} questões Cebraspe. Entenda o porquê de cada resposta.`
  : modulo && variant === 'side'
  ? `${modulo.nome}: ${modulo.questoes} questões reais da Cebraspe`
  : modulo
  ? `Treine ${modulo.nome} com questões reais da Cebraspe`
  : `${APOSTILA_QUESTIONS} questões Cebraspe. Entenda o porquê de cada resposta.`;
const text = modulo
  ? `O módulo de ${modulo.nome} da apostila tem ${modulo.questoes} questões de provas já aplicadas, cada uma com comentário.`
  : '206 páginas em PDF, cinco módulos e um comentário em cada questão. Estude no seu ritmo.';
---
<aside class:list={['apostila', variant]} data-banner="apostila" data-slot={slot} aria-label={apostilaAriaLabel}>
  <img class="cover" src={APOSTILA_COVER} alt="" width="128" height="171" loading="lazy" decoding="async" />
  <div class="body">
    <div class="banner-meta"><p class="eyebrow">Apostila digital · Cebraspe</p><span class="price" aria-hidden="true">{APOSTILA_PRICE}</span></div>
    <p class="title">{title}</p>
    <p class="text">{text}</p>
    <a class="btn" href={APOSTILA_URL} data-banner-link><span class="label"><span class="lg">Quero a apostila por </span><span class="sm">Comprar por </span>{APOSTILA_PRICE}</span> <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a>
  </div>
</aside>

<style>
  /* Same fixed navy, white typography and natural yellow as /apostila/, in both site themes. */
  .apostila {
    --banner-yellow: #ffda44;
    display: flex;
    gap: 24px;
    align-items: center;
    margin: 36px 0;
    padding: 26px;
    border-radius: 16px;
    background: #101c34;
    color: #fff;
    border: 1px solid #ffffff26;
    box-shadow: 0 8px 26px #0002;
    font-family: var(--f-inter, Arial), sans-serif;
  }
  .cover { flex: none; width: 128px; height: auto; aspect-ratio: 3 / 4; margin: 0; max-width: none; border-radius: 4px; border: 1px solid #ffffff26; box-shadow: 5px 9px 20px #0005; }
  .body { min-width: 0; flex: 1; }
  .banner-meta { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 12px; }
  .eyebrow { margin: 0; color: #c5cee2; font-size: .78rem; font-weight: 500; }
  .price { flex-shrink: 0; color: #fff; font-size: 1.2rem; font-weight: 700; letter-spacing: -.04em; line-height: 1.2; }
  .title { margin: 0 0 12px; color: #fff; font-family: var(--f-archivo, Arial), sans-serif; font-size: 1.3rem; font-weight: 800; letter-spacing: -.035em; line-height: 1.18; }
  .text { margin: 0 0 20px; color: #bfcbe0; font-size: .9375rem; line-height: 1.75; max-width: 55ch; }
  .btn {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    min-height: 50px;
    padding: 12px 22px;
    border-radius: 9px;
    background: var(--banner-yellow);
    color: #182238;
    box-shadow: inset 0 1px 0 #fff5, 0 4px 14px #0002;
    font-size: .94rem;
    font-weight: 700;
    line-height: 1.4;
    text-decoration: none;
  }
  .btn:hover, .btn:focus-visible { background: #ffe36b; box-shadow: inset 0 1px 0 #fff6, 0 7px 22px #ffda4438; }
  .btn:focus-visible { outline: 3px solid var(--banner-yellow); outline-offset: 5px; }
  .btn:active { background: #f5cc32; }
  .btn .label { white-space: nowrap; }
  .btn svg { flex-shrink: 0; }
  .btn .sm { display: none; }
  .apostila.hero { gap: 36px; margin: 8px 0; padding: 36px 40px; border-radius: 22px; }
  .hero .cover { width: 170px; }
  .hero .eyebrow { font-size: .85rem; }
  .hero .price { font-size: 1.65rem; }
  .hero .title { max-width: 30ch; font-size: clamp(1.5rem, 3vw, 2.2rem); }
  .hero .text { font-size: 1rem; }
  .hero .btn { min-height: 56px; font-size: 1rem; }
  .apostila.side { display: grid; grid-template-columns: 72px minmax(0, 1fr); grid-template-areas: 'cover info' 'cta cta'; gap: 14px; margin: 0; padding: 16px; }
  .side .cover { grid-area: cover; width: 72px; }
  .side .body { display: contents; }
  .side .banner-meta, .side .text { display: none; }
  .side .title { grid-area: info; align-self: center; margin: 0; font-size: .95rem; }
  .side .btn { grid-area: cta; width: 100%; padding: 12px; font-size: .9rem; }
  .side .btn .lg { display: none; }
  .side .btn .sm { display: inline; }
  @keyframes banner-sunlight {
    from { transform: translateX(-350%) skewX(-20deg); }
    to { transform: translateX(500%) skewX(-20deg); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .btn { transition: background .2s ease, box-shadow .2s ease, transform .2s ease; }
    .btn svg { transition: transform .2s ease; }
    .btn:hover, .btn:focus-visible { transform: translateY(-2px); }
    .btn:hover svg, .btn:focus-visible svg { transform: translateX(3px); }
    .btn:active { transform: translateY(0); }
    .is-visible .btn::after {
      content: '';
      position: absolute;
      inset-block: -10%;
      left: 0;
      width: 30%;
      background: linear-gradient(90deg, transparent, #fff7, transparent);
      pointer-events: none;
      animation: banner-sunlight 1.3s .3s both;
    }
  }
  @media (max-width: 640px) {
    .apostila.hero, .apostila.wide { display: grid; grid-template-columns: 84px minmax(0, 1fr); grid-template-areas: 'cover info' 'cta cta'; gap: 14px 16px; align-items: start; margin: 8px 0; padding: 18px; border-radius: 16px; }
    .hero .cover, .wide .cover { grid-area: cover; width: 84px; }
    .hero .body, .wide .body { display: contents; }
    .hero .banner-meta, .wide .banner-meta, .hero .text, .wide .text { display: none; }
    .hero .title, .wide .title { grid-area: info; align-self: center; margin: 0; font-size: 1.05rem; line-height: 1.3; }
    .hero .btn, .wide .btn { grid-area: cta; width: 100%; min-height: 50px; padding: 12px 14px; font-size: .95rem; }
    .btn .lg { display: none; }
    .btn .sm { display: inline; }
  }
</style>

<script>
  // Medição no GA4 (gtag já existe no BaseLayout): banner_view quando 50% do banner aparece, banner_click ao clicar.
  declare const gtag: (...args: unknown[]) => void;
  const send = (name: string, slot: string) => {
    try { gtag('event', name, { banner_id: 'apostila', slot }); } catch { /* sem analytics */ }
  };
  const seen = new WeakSet<Element>();
  const io = 'IntersectionObserver' in window
    ? new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting && !seen.has(e.target)) {
            seen.add(e.target);
            e.target.classList.add('is-visible');
            send('banner_view', (e.target as HTMLElement).dataset.slot ?? '');
            io!.unobserve(e.target);
          }
        });
      }, { threshold: 0.5 })
    : null;
  const watch = () => document.querySelectorAll('[data-banner="apostila"]').forEach((el) => io?.observe(el));
  watch();
  document.addEventListener('click', (ev) => {
    const a = (ev.target as HTMLElement).closest('[data-banner-link]');
    const box = a?.closest<HTMLElement>('[data-banner="apostila"]');
    if (box) send('banner_click', box.dataset.slot ?? '');
  });
  // Banners injetados depois (meio do artigo) avisam por este evento.
  document.addEventListener('banner:added', watch);
</script>
