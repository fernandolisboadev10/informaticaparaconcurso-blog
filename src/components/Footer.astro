---
import { categories as categoryList } from "../data/categories";

const categories = [
  { label: "Início", href: "/" },
  ...categoryList.map((c) => ({ label: c.name, href: `/category/${c.slug}/` })),
];

const quickLinks = [
  { label: 'Sobre nós', href: '/sobre-nos/' },
  { label: 'Fale conosco', href: '/fale-conosco/' },
  { label: 'Transparência', href: '/transparencia/' },
];
---
<footer class="site-footer">
  <div class="container grid">
    <div class="about-col">
      <a href="/" class="brand" aria-label="Informática para Concursos - Início">
        <span class="brand-mark"><img class="brand-logo" src="/images/logo-icon.webp" alt="" width="28" height="28" /><span class="brand-name">Informática<small>para Concursos</small></span></span>
      </a>
      <p class="tagline">
        Resumos, simulados e análises das bancas para você estudar informática com foco no que realmente cai nas provas de concursos públicos.
      </p>
    </div>

    <div>
      <p class="col-title">Links rápidos</p>
      <ul>
        {quickLinks.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class="col-title">Categorias</p>
      <ul>
        {categories.map((c) => (
          <li><a href={c.href}>{c.label}</a></li>
        ))}
      </ul>
    </div>

  </div>

  <div class="bottom">
    <div class="container bottom-inner">
      <p>© {new Date().getFullYear()} Informática para Concursos. Todos os direitos reservados.</p>
      <div class="legal-links">
        <a href="/politica-de-privacidade/">Política de Privacidade</a>
        <a href="/politica-de-cookies/">Política de Cookies</a>
        <a href="#" data-open-cookie-settings>Configurações de cookies</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 80px;
  }

  .grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 40px;
    padding-block: 56px 40px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    margin: 0 0 16px;
  }

  .brand-mark {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .brand-logo {
    display: block;
    height: 28px;
    width: 28px;
    image-rendering: pixelated;
  }

  .brand-name {
    display: flex;
    flex-direction: column;
    gap: 3px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 21px;
    line-height: 1;
    color: var(--ink-strong);
    letter-spacing: -0.01em;
  }

  .brand-name small {
    font-family: var(--font-body);
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--violet);
  }

  .tagline {
    color: var(--ink-soft);
    font-size: 0.9rem;
    max-width: 38ch;
    margin: 0 0 20px;
  }

  .col-title {
    position: relative;
    font-size: 0.95rem;
    color: var(--ink-strong);
    font-weight: 700;
    margin: 0 0 20px;
    padding-bottom: 12px;
  }

  .col-title::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 32px;
    height: 3px;
    border-radius: 2px;
    background: linear-gradient(135deg, var(--violet), var(--rose));
  }


  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  ul a {
    text-decoration: none;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  ul a:hover {
    color: var(--teal);
  }

  .bottom {
    background: var(--ink-deep);
  }

  .bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding-block: 20px;
  }

  .bottom-inner p {
    margin: 0;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.75);
  }

  .legal-links {
    display: flex;
    gap: 24px;
  }

  .legal-links a {
    text-decoration: none;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.75);
  }

  .legal-links a:hover {
    color: #ffffff;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .bottom-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
