---
import type { CollectionEntry } from 'astro:content';
import QuestionsTag from './QuestionsTag.astro';
import { categoryColor } from '../utils/categoryColor';

interface Props {
  subjects: {
    name: string;
    href: string;
    posts: CollectionEntry<'blog'>[];
    questions: number;
  }[];
}
const { subjects } = Astro.props;
---
<div class="subjects">
  {subjects.map((s) => (
    <article class="subject" style={`--cat:${categoryColor(s.name)}`}>
      <span class="bar" aria-hidden="true"></span>
      <div class="head">
        <h3><a href={s.href}>{s.name}</a></h3>
        <span class="lessons">{s.posts.length} {s.posts.length === 1 ? 'aula' : 'aulas'}</span>
      </div>
      <ul class="links">
        {s.posts.slice(0, 2).map((p) => (
          <li><a href={`/${p.id}`}>{p.data.title}</a></li>
        ))}
      </ul>
      <div class="foot">
        <QuestionsTag count={s.questions} />
        <a class="practice" href={`/questoes/?materia=${encodeURIComponent(s.name)}`}>Praticar →</a>
      </div>
    </article>
  ))}
</div>

<style>
  .subjects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));
    gap: 16px;
  }

  .subject {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
    overflow: hidden;
    transition: border-color 0.15s;
  }

  .subject:hover {
    border-color: var(--line-hover);
  }

  .bar {
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    background: var(--cat);
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  h3 {
    font-size: 1.625rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  h3 a {
    color: inherit;
    text-decoration: none;
  }

  h3 a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .lessons {
    font-size: 0.875rem;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .links {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 8px 0 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .links a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding-block: 8px;
    font-size: 0.9375rem;
    line-height: 1.4;
    color: var(--ink);
    text-decoration: none;
  }

  .links a:hover {
    color: var(--ink-strong);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .foot {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 4px;
  }

  .practice {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--cat);
    text-decoration: none;
  }

  :global(:root[data-theme='light']) .practice {
    color: color-mix(in srgb, var(--cat) 55%, #000);
  }

  .practice:hover {
    filter: brightness(1.15);
  }
</style>
