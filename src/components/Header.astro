---
import { categories as categoryList } from '../data/categories';
import { questoesAriaLabel, QUESTOES_URL } from '../data/questoes';

const nav = [
  { label: 'Início', href: '/' },
  ...categoryList.map((c) => ({ label: c.name, href: `/category/${c.slug}/` })),
];

const currentHref = Astro.url.pathname + Astro.url.search;
---
<header class="site-header">
  <div class="bar">
    <button type="button" class="menu-toggle" id="menu-toggle" aria-label="Abrir menu" aria-expanded="false" aria-controls="mobile-nav">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
    </button>
    <a href="/" class="brand" aria-label="Informática para Concurso - Início">
      <img class="brand-logo" src="/images/logo-icon.webp" alt="" width="34" height="34" />
      <span class="brand-name">Informática<small>para Concurso</small></span>
    </a>
    <nav class="nav" aria-label="Principal">
      {nav.map((item) => (
        <a href={item.href} class:list={{ active: item.href === currentHref }} aria-current={item.href === currentHref ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <div class="right-controls">
      <a href={QUESTOES_URL} class="cta-questoes cta-desktop" target="_blank" rel="noopener" aria-label={`Questões: ${questoesAriaLabel}`}>
        Questões
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </a>
      <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Alternar tema claro ou escuro">
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="12" cy="12" r="4" />
          <line x1="12" y1="2" x2="12" y2="4" />
          <line x1="12" y1="20" x2="12" y2="22" />
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
          <line x1="2" y1="12" x2="4" y2="12" />
          <line x1="20" y1="12" x2="22" y2="12" />
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
        </svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
        </svg>
      </button>
      <div class="search-wrap">
        <form class="search-form" action="/blog" method="get" id="search-form">
          <input type="search" name="q" placeholder="Buscar artigos…" aria-label="Buscar artigos" />
        </form>
        <button type="button" class="search-toggle" id="search-toggle" aria-label="Buscar no site" aria-expanded="false">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="5.5" stroke="currentColor" stroke-width="1.8"></circle><path d="M12.5 12.5L16 16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
        </button>
      </div>
    </div>
  </div>
  <nav class="mobile-nav" id="mobile-nav" aria-label="Menu">
    {nav.map((item) => (
      <a href={item.href} class:list={{ active: item.href === currentHref }}>{item.label}</a>
    ))}
    <a href={QUESTOES_URL} class="cta-questoes" target="_blank" rel="noopener" aria-label={`Questões: ${questoesAriaLabel}`}>Questões</a>
  </nav>
</header>

<script>
  const searchToggle = document.getElementById('search-toggle');
  const searchWrap = document.querySelector('.search-wrap');
  const searchInput = document.querySelector<HTMLInputElement>('.search-form input');

  searchToggle?.addEventListener('click', () => {
    const open = searchWrap?.classList.toggle('open');
    searchToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (open) searchInput?.focus();
  });

  const themeToggle = document.getElementById('theme-toggle');

  themeToggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const currentIsDark = root.getAttribute('data-theme') !== 'light';
    const next = currentIsDark ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
  });

  const menuToggle = document.getElementById('menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');

  menuToggle?.addEventListener('click', () => {
    const open = mobileNav?.classList.toggle('open');
    menuToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });

  mobileNav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileNav.classList.remove('open');
      menuToggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .bar {
    max-width: 1180px;
    margin-inline: auto;
    padding: 12px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px 16px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    color: var(--violet);
  }

  .brand-logo {
    display: block;
    flex: none;
    height: 34px;
    width: 34px;
    image-rendering: pixelated;
  }

  .brand-name {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 21px;
    line-height: 1.1;
    color: var(--ink-strong);
    letter-spacing: -0.01em;
  }

  .brand-name small {
    font-family: var(--font-body);
    font-size: 10.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--violet);
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 2px;
    flex: 1;
  }

  .nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 7px;
    border-radius: 10px;
    text-decoration: none;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .nav a:hover {
    color: var(--ink-strong);
    background: var(--surface-2);
  }

  .nav a.active {
    color: var(--ink-strong);
    background: color-mix(in srgb, var(--violet) 18%, var(--bg));
  }

  /* Botão "Questões": CTA do design (teal, texto escuro). */
  .cta-questoes {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--cta);
    color: var(--cta-ink);
    font-family: var(--font-display);
    font-weight: 800;
    text-decoration: none;
  }

  .cta-desktop {
    min-height: 44px;
    padding: 0 20px;
    border-radius: 10px;
    font-size: 15px;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .cta-questoes:hover {
    filter: brightness(1.08);
  }

  .mobile-nav a.cta-questoes {
    justify-content: center;
    color: var(--cta-ink);
    margin: 14px 24px;
    padding: 12px 20px;
    border-bottom: none;
    border-radius: 10px;
  }

  .right-controls {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .menu-toggle,
  .search-toggle,
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--ink-soft);
    cursor: pointer;
    flex-shrink: 0;
  }

  .menu-toggle {
    display: none;
  }

  .menu-toggle:hover,
  .search-toggle:hover,
  .theme-toggle:hover {
    color: var(--ink-strong);
    background: var(--surface-2);
    border-color: var(--line-hover);
  }

  .search-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .search-form {
    width: 0;
    overflow: hidden;
    opacity: 0;
    transition: width 0.2s ease, opacity 0.2s ease;
  }

  .search-wrap.open .search-form {
    width: 180px;
    opacity: 1;
  }

  .search-form input {
    width: 100%;
    min-height: 44px;
    padding: 8px 14px;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    font-family: var(--font-body);
    font-size: 0.9rem;
    background: var(--surface);
    color: var(--ink);
  }

  .search-form input:focus {
    border-color: var(--violet);
  }

  .theme-toggle .icon-moon {
    display: none;
  }

  :root:not([data-theme='light']) .theme-toggle .icon-sun {
    display: none;
  }

  :root:not([data-theme='light']) .theme-toggle .icon-moon {
    display: block;
  }

  .mobile-nav {
    display: none;
    flex-direction: column;
    max-height: 0;
    overflow: hidden;
    border-top: 1px solid transparent;
    transition: max-height 0.25s ease;
  }

  .mobile-nav.open {
    max-height: min(80vh, 800px);
    overflow-y: auto;
    border-top-color: var(--line);
  }

  .mobile-nav a {
    text-decoration: none;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--ink-soft);
    padding: 14px 24px;
    border-bottom: 1px solid var(--line);
  }

  .mobile-nav a.active {
    color: var(--ink-strong);
    background: color-mix(in srgb, var(--violet) 14%, var(--bg));
  }

  @media (max-width: 1180px) {
    .nav {
      display: none;
    }

    .cta-desktop {
      display: none;
    }

    .menu-toggle {
      display: flex;
    }

    .mobile-nav {
      display: flex;
    }

    .search-wrap.open .search-form {
      width: 130px;
    }

    /* Mobile: menu button on the left, logo centered, theme and search on the right. */
    .bar {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      gap: 8px;
    }

    .menu-toggle {
      justify-self: start;
    }

    .brand {
      justify-self: center;
    }

    .theme-toggle,
    .search-toggle,
    .menu-toggle {
      width: 40px;
      height: 40px;
    }

    .bar:has(.search-wrap.open) .brand {
      visibility: hidden;
    }

    .right-controls {
      justify-self: end;
      gap: 6px;
      position: relative;
      z-index: 1;
      background: var(--bg);
    }
  }

  @media (max-width: 400px) {
    .search-wrap.open .search-form {
      width: 100px;
    }

    .brand-name {
      font-size: 18px;
    }

    .brand-logo {
      width: 26px;
      height: 26px;
    }
  }
</style>
