---
interface Props {
  count: number;
}
const { count } = Astro.props;
---
{count > 0 && <span class="questions">{count} {count === 1 ? 'questão' : 'questões'}</span>}

<style>
  /* The site's "Cai na prova" highlighter, used to flag posts that end with exam questions. */
  .questions {
    display: inline-block;
    padding: 1px 7px;
    border-radius: 3px;
    background: var(--marker);
    color: var(--marker-ink);
    font-family: var(--font-body);
    font-size: 0.76rem;
    font-weight: 700;
    line-height: 1.5;
    white-space: nowrap;
  }
</style>
