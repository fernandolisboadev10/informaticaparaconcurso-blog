---
import { bancaOf, questoesAriaLabel, QUESTOES_URL } from '../data/questoes';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const banca = bancaOf(slug);
const title = banca ? `Treine no estilo ${banca}` : 'Treine com questões novas, no estilo da sua banca';
const href = QUESTOES_URL;
---
<aside class="gerador" data-banner="gerador" data-slot="post-fim-gerador" aria-labelledby="questoes-cta-title">
  <div class="info">
    <p class="eyebrow"><span class="dot" aria-hidden="true"></span>Gerador de Questões com IA</p>
    <h2 id="questoes-cta-title">{title}</h2>
    <p class="text">
      Nossa ferramenta de estudo com IA cria questões novas a cada pedido, por assunto, nível e banca, e ajuda a revisar os itens em que você errou.
    </p>
    <ul class="chips" aria-label="O que você escolhe">
      <li>Por assunto</li>
      <li>Por nível</li>
      <li>Por banca</li>
      <li>Gabarito comentado</li>
    </ul>
    <a class="btn" href={href} target="_blank" rel="noopener" data-banner-link aria-label={`Conhecer o ${questoesAriaLabel}`}>
      Conhecer o Gerador de Questões
      <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </a>
  </div>

  <div class="mock" aria-hidden="true">
    <div class="mock-head"><span class="ia">IA</span><span class="gen">Questão gerada agora</span></div>
    <p class="mock-q">Julgue o item. O protocolo TCP oferece entrega confiável, com controle de fluxo e retransmissão de segmentos perdidos.</p>
    <div class="opts">
      <span class="opt o-ok"><b>C</b> Certo<i>✓ Gabarito</i></span>
      <span class="opt"><b>E</b> Errado</span>
    </div>
    <p class="mock-c">Comentário: o TCP garante a entrega ordenada dos dados.</p>
  </div>
</aside>

<style>
  .gerador {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 28px;
    align-items: center;
    margin: 36px 0;
    padding: 28px;
    border-radius: 20px;
    color: #fff;
    background:
      radial-gradient(circle at 100% 0%, rgba(45, 212, 191, 0.28), transparent 55%),
      linear-gradient(135deg, #0a6268 0%, #0b4a63 55%, #1b2a6b 100%);
    box-shadow: 0 0 0 1px rgba(45, 212, 191, 0.5), 0 0 26px rgba(45, 212, 191, 0.22);
  }

  .info { min-width: 0; position: relative; z-index: 2; }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 8px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #9ff3ea;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #2dd4bf;
    box-shadow: 0 0 0 0 rgba(45, 212, 191, 0.7);
  }

  .gerador h2 {
    margin: 0 0 10px;
    font-size: clamp(1.35rem, 2.6vw, 1.75rem);
    line-height: 1.2;
    color: #fff;
  }

  .text {
    margin: 0 0 16px;
    color: #e3fbf8;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0 0 20px;
    padding: 0;
  }

  .chips li {
    margin: 0;
    padding: 4px 12px;
    border-radius: 999px;
    border: 1px solid rgba(159, 243, 234, 0.45);
    background: rgba(255, 255, 255, 0.08);
    color: #d9fbf6;
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 26px;
    border-radius: 14px;
    background: #2dd4bf;
    color: #04201d;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.0625rem;
    text-decoration: none;
  }

  .btn svg { transition: transform 0.2s; }
  .btn:hover { filter: brightness(1.08); }
  .btn:hover svg { transform: translateX(4px); }

  /* Cartão de exemplo: uma questão sendo respondida */
  .mock {
    position: relative;
    z-index: 2;
    padding: 16px;
    border-radius: 16px;
    background: #0d1626;
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 16px 34px rgba(0, 0, 0, 0.4);
    color: #d5dcec;
    font-size: 0.8125rem;
  }

  .mock-head { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }
  .ia {
    padding: 2px 8px;
    border-radius: 6px;
    background: #2dd4bf;
    color: #04201d;
    font-weight: 800;
    font-size: 0.7rem;
  }
  .gen { color: #9ff3ea; font-weight: 600; }

  .mock-q { margin: 0 0 12px; line-height: 1.5; color: #fff; }

  .opts { display: flex; flex-direction: column; gap: 6px; }
  .opt {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 10px;
    border: 1.5px solid #2f3d5c;
    background: #0b0e14;
  }
  .opt b {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: #1b2438;
    font-size: 0.75rem;
  }
  .opt i { margin-left: auto; font-style: normal; font-weight: 700; font-size: 0.7rem; opacity: 0; color: #34d399; }
  .mock-c { margin: 10px 0 0; color: #a9b4c9; line-height: 1.45; opacity: 0; }

  /* Efeitos de banner (desligados para quem prefere menos movimento) */
  @keyframes g-glow {
    0%, 100% { box-shadow: 0 0 0 1px rgba(45, 212, 191, 0.4), 0 0 16px rgba(45, 212, 191, 0.14); }
    50% { box-shadow: 0 0 0 1px rgba(45, 212, 191, 0.95), 0 0 34px rgba(45, 212, 191, 0.42); }
  }
  @keyframes g-shine {
    0%, 55% { transform: translateX(-130%) skewX(-20deg); }
    100% { transform: translateX(260%) skewX(-20deg); }
  }
  @keyframes g-pulse {
    0%, 100% { box-shadow: 0 0 6px rgba(45, 212, 191, 0.5), 0 0 14px rgba(45, 212, 191, 0.25); }
    50% { box-shadow: 0 0 14px rgba(45, 212, 191, 0.9), 0 0 30px rgba(45, 212, 191, 0.5); transform: scale(1.03); }
  }
  @keyframes g-dot {
    0% { box-shadow: 0 0 0 0 rgba(45, 212, 191, 0.7); }
    70%, 100% { box-shadow: 0 0 0 9px rgba(45, 212, 191, 0); }
  }
  @keyframes g-float {
    0%, 100% { transform: translateY(0) rotate(0.6deg); }
    50% { transform: translateY(-6px) rotate(-0.6deg); }
  }
  @keyframes g-pick {
    0%, 30% { border-color: #2f3d5c; background: #0b0e14; }
    40%, 90% { border-color: #34d399; background: rgba(52, 211, 153, 0.14); }
    100% { border-color: #2f3d5c; background: #0b0e14; }
  }
  @keyframes g-show {
    0%, 35% { opacity: 0; transform: translateY(4px); }
    45%, 90% { opacity: 1; transform: none; }
    100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .gerador { animation: g-glow 3.2s ease-in-out infinite; }
    .gerador::after {
      content: '';
      position: absolute;
      inset: 0;
      width: 30%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.14), transparent);
      transform: translateX(-130%) skewX(-20deg);
      animation: g-shine 5.5s ease-in-out infinite;
      pointer-events: none;
      z-index: 1;
    }
    .btn { animation: g-pulse 2.6s ease-in-out infinite; }
    .dot { animation: g-dot 1.8s ease-out infinite; }
    .mock { animation: g-float 5s ease-in-out infinite; }
    .o-ok { animation: g-pick 8s ease-in-out infinite; }
    .o-ok i { animation: g-show 8s ease-in-out infinite; }
    .mock-c { animation: g-show 8s ease-in-out infinite; }
  }

  /* Sem animação: mostra já o gabarito, para o cartão não ficar vazio */
  @media (prefers-reduced-motion: reduce) {
    .o-ok { border-color: #34d399; background: rgba(52, 211, 153, 0.14); }
    .o-ok i, .mock-c { opacity: 1; }
  }

  @media (max-width: 760px) {
    .gerador { grid-template-columns: minmax(0, 1fr); padding: 22px 18px; gap: 20px; }
    .mock { display: none; }
    .btn { width: 100%; justify-content: center; padding: 0 16px; font-size: 1rem; }
  }
</style>

<script>
  // Medição no GA4: banner_view quando 50% do banner aparece e banner_click ao clicar.
  declare const gtag: (...args: unknown[]) => void;
  const send = (name: string, slot: string) => {
    try { gtag('event', name, { banner_id: 'gerador', slot }); } catch { /* sem analytics */ }
  };
  const boxes = document.querySelectorAll<HTMLElement>('[data-banner="gerador"]');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          send('banner_view', (e.target as HTMLElement).dataset.slot ?? '');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.5 });
    boxes.forEach((b) => io.observe(b));
  }
  document.addEventListener('click', (ev) => {
    const a = (ev.target as HTMLElement).closest('[data-banner="gerador"] [data-banner-link]');
    if (a) send('banner_click', a.closest<HTMLElement>('[data-banner="gerador"]')?.dataset.slot ?? '');
  });
</script>
