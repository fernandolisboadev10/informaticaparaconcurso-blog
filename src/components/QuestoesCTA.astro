---
import QuestionPhoneDemo from './QuestionPhoneDemo.astro';
import { questoesAriaLabel, QUESTOES_URL } from '../data/questoes';

interface Props {
  slug?: string;
  placement?: 'home' | 'article';
}

const { slug, placement = 'article' } = Astro.props;
const headingId = slug ? `questoes-cta-${slug}` : 'questoes-cta-home';
const trackingSlot = placement === 'home' ? 'home-gerador' : 'post-fim-gerador';
---
<aside class:list={['band', { 'band-article': placement === 'article' }]} data-banner="gerador" data-slot={trackingSlot} data-question-demo-banner aria-labelledby={headingId}>
  <div class="band-text">
    <p class="band-eyebrow"><span class="band-dot" aria-hidden="true"></span>Gerador de Questões com IA</p>
    <h2 id={headingId}>Crie questões personalizadas para o seu edital.</h2>
    <p class="band-lede">Gere questões de acordo com o conteúdo programático do seu edital, no estilo da sua banca, e confira o gabarito comentado.</p>
    <ul class="band-chips" aria-label="O que você escolhe">
      <li>Seu edital</li>
      <li>Sua banca</li>
      <li>Nível de dificuldade</li>
      <li>Gabarito comentado</li>
    </ul>
    <a class="btn-cta" href={QUESTOES_URL} target="_blank" rel="noopener" data-banner-link aria-label={`Criar questões: ${questoesAriaLabel}`}>
      Criar questões
      <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </a>
  </div>
  <QuestionPhoneDemo />
</aside>

<style>
  .band {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: 40px;
    align-items: center;
    padding: 44px;
    border-radius: 24px;
    border: 2px solid #38aaff;
    color: #fff;
    background:
      radial-gradient(circle at 100% 0%, rgba(56, 170, 255, 0.16), transparent 50%),
      linear-gradient(135deg, #071326 0%, #0c2442 100%);
    box-shadow: 0 0 22px rgba(56, 170, 255, 0.3);
  }

  .band-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    min-width: 0;
    position: relative;
    z-index: 2;
  }

  .band-eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #93ceff;
  }

  .band-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #38aaff;
  }

  .band-text h2 {
    margin: 0;
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: #fff;
    text-wrap: balance;
  }

  .band-lede {
    margin: 0;
    max-width: 560px;
    font-size: 1.0625rem;
    color: #c5d6ea;
    text-wrap: pretty;
  }

  .band-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 4px 0 8px;
    padding: 0;
  }

  .band-chips li {
    padding: 5px 14px;
    border-radius: 999px;
    border: 1px solid rgba(56, 170, 255, 0.5);
    background: rgba(56, 170, 255, 0.08);
    color: #bbdfff;
    font-size: 0.875rem;
    font-weight: 600;
  }

  /* Botão: azul neon com texto escuro */
  .band .btn-cta {
    background: #38aaff;
    color: #071426;
    box-shadow: 0 0 10px rgba(56, 170, 255, 0.45);
  }

  .band .btn-cta svg {
    transition: transform 0.2s;
  }

  .band .btn-cta:hover {
    background: #93ceff;
    filter: none;
  }

  .band .btn-cta:hover svg {
    transform: translateX(4px);
  }

  .band .btn-cta:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }

  @media (max-width: 900px) {
    .band {
      grid-template-columns: minmax(0, 1fr);
      padding: 32px 24px;
    }

    .band .btn-cta {
      width: 100%;
      justify-content: center;
    }
  }


  .btn-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 52px;
    padding: 12px 24px;
    border-radius: 12px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1rem;
    text-decoration: none;
  }

  .band-article {
    margin: 36px 0;
    padding: 28px;
    gap: 24px;
    grid-template-columns: minmax(0, 1fr) 240px;
    border-radius: 20px;
  }
  .band-article h2 { font-size: clamp(1.4rem, 2.6vw, 1.75rem); }
  .band-article .band-lede { font-size: 1rem; }
  .band-article .band-chips { gap: 6px; }
  .band-article .band-chips li { padding: 4px 10px; font-size: .8125rem; }

  @media (max-width: 900px) {
    .band-article { grid-template-columns: minmax(0, 1fr); padding: 24px 18px; }
  }
  @media (max-width: 400px) {
    .band { padding: 24px 18px; gap: 24px; }
    .band-chips li { padding: 4px 10px; }
  }
</style>

<script>
  // Medição no GA4: banner_view quando 50% do banner aparece e banner_click ao clicar.
  declare const gtag: (...args: unknown[]) => void;
  const send = (name: string, slot: string) => {
    try { gtag('event', name, { banner_id: 'gerador', slot }); } catch { /* sem analytics */ }
  };
  const boxes = document.querySelectorAll<HTMLElement>('[data-banner="gerador"]');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          send('banner_view', (e.target as HTMLElement).dataset.slot ?? '');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.5 });
    boxes.forEach((b) => io.observe(b));
  }
  document.addEventListener('click', (ev) => {
    const a = (ev.target as HTMLElement).closest('[data-banner="gerador"] [data-banner-link]');
    if (a) send('banner_click', a.closest<HTMLElement>('[data-banner="gerador"]')?.dataset.slot ?? '');
  });
</script>
