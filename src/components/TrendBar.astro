---
// Faixa fina sob o header com os posts mais recentes (sem dados inventados).
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
}
const { posts } = Astro.props;
---
<div class="trend">
  <div class="container trend-in">
    <div class="trend-l"><span class="dot"></span>Agora</div>
    <div class="trend-items">
      {posts.map((p, i) => (
        <a href={`/${p.id}`}><b>{String(i + 1).padStart(2, '0')}</b><span>{p.data.title}</span></a>
      ))}
    </div>
  </div>
</div>

<style>
  .trend {
    background: #0f1535;
    color: #ddd3fd;
  }

  .trend-in {
    display: flex;
    align-items: center;
    gap: 20px;
    min-height: 48px;
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #b6ff00;
    box-shadow: 0 0 0 4px rgba(182, 255, 0, 0.25), 0 0 10px 2px rgba(182, 255, 0, 0.7);
    animation: blink 1.1s ease-in-out infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.15; }
  }

  @media (prefers-reduced-motion: reduce) {
    .dot { animation: none; }
  }

  .trend-l {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #b6ff00;
    text-shadow: 0 0 8px rgba(182, 255, 0, 0.55);
  }

  .trend-items {
    display: flex;
    gap: 28px;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-mask-image: linear-gradient(90deg, #000 90%, transparent);
    mask-image: linear-gradient(90deg, #000 90%, transparent);
  }

  .trend-items::-webkit-scrollbar {
    display: none;
  }

  .trend-items a {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    max-width: 340px;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    color: #ddd3fd;
    transition: color 0.15s ease;
  }

  .trend-items a:hover {
    color: #fff;
  }

  .trend-items b {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 500;
    color: #a99fd0;
  }

  .trend-items span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 600px) {
    .trend-l {
      font-size: 0.6rem;
    }
  }
</style>
