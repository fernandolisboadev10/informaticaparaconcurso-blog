---
interface Props {
  title: string;
  href?: string;
  linkLabel?: string;
  id?: string;
}
const { title, href, linkLabel, id } = Astro.props;
---
<div class="section-head">
  <h2 id={id}>{title}</h2>
  {href && linkLabel && <a class="more" href={href}>{linkLabel} →</a>}
</div>

<style>
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;
  }

  h2 {
    font-size: 1.625rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .more {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 1rem;
    font-weight: 600;
    color: var(--violet);
    text-decoration: none;
    white-space: nowrap;
  }

  .more:hover {
    color: var(--ink-strong);
  }
</style>
