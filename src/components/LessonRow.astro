---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import QuestionsTag from './QuestionsTag.astro';
import { questionCount } from '../utils/quizzes';
import { categoryColor } from '../utils/categoryColor';

interface Props {
  slug: string;
  title: string;
  category: string;
  date: Date;
  readingTime?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  priority?: boolean;
}
const { slug, title, category, date, readingTime, image, imageAlt, priority = false } = Astro.props;

const formattedDate = date.toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', timeZone: 'UTC' });
---
<a href={`/${slug}`} class="row" style={`--cat:${categoryColor(category)}`}>
  <span class="thumb">
    {image && <Image src={image} alt={imageAlt ?? title} width={440} height={275} quality={70} priority={priority} />}
  </span>
  <span class="info">
    <span class="labels">
      <span class="cat">{category}</span>
      <QuestionsTag count={questionCount(slug)} />
    </span>
    <span class="title">{title}</span>
    <span class="meta">{formattedDate}{readingTime && ` · ${readingTime} de leitura`}</span>
  </span>
</a>

<style>
  .row {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 24px;
    align-items: center;
    padding-block: 18px;
    color: inherit;
    text-decoration: none;
  }

  .thumb {
    display: block;
    aspect-ratio: 16 / 10;
    border-radius: 12px;
    overflow: hidden;
    background: var(--surface-2);
    border: 1px solid var(--line-strong);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .labels {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    font-size: 0.8125rem;
  }

  .cat {
    font-weight: 700;
    color: var(--cat);
  }

  :global(:root[data-theme='light']) .cat {
    color: color-mix(in srgb, var(--cat) 55%, #000);
  }

  .title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    line-height: 1.35;
    color: var(--ink-strong);
    text-wrap: pretty;
  }

  .row:hover .title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .meta {
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }

  @media (max-width: 640px) {
    .row {
      grid-template-columns: minmax(0, 1fr) 112px;
      gap: 16px;
      align-items: start;
    }

    .thumb {
      order: 2;
      aspect-ratio: 1 / 1;
    }
  }
</style>
