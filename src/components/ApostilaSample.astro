---
import { apostilaModules } from '../data/apostila-samples';
---
<div class="sample" data-apostila-sample>
  <div class="sample-picker" role="group" aria-label="Escolha a matéria da questão">
    {apostilaModules.map((module, i) => (
      <button type="button" class="subject" data-subject={module.id} aria-pressed={i === 0 ? 'true' : 'false'} aria-controls={`sample-${module.id}`} hidden>{module.short}</button>
    ))}
  </div>
  {apostilaModules.map((module) => (
    <article class="question" id={`sample-${module.id}`} data-question={module.id} data-answer={module.answer} aria-labelledby={`sample-title-${module.id}`}>
      <div class="question-top"><span>Amostra da apostila</span><span>Página {module.page}</span></div>
      <h3 id={`sample-title-${module.id}`}>{module.name}</h3>
      <p class="source">{module.source} · Questão {String(module.question).padStart(3, '0')}</p>
      <p class="statement">{module.text}</p>
      <div class="answers" role="group" aria-label="Sua resposta" hidden>
        <button type="button" data-answer-choice="C" aria-pressed="false"><span>C</span> Certo</button>
        <button type="button" data-answer-choice="E" aria-pressed="false"><span>E</span> Errado</button>
      </div>
      <p class="result" role="status" aria-live="polite" aria-atomic="true"></p>
      <details class="explanation">
        <summary>Ver gabarito e comentário</summary>
        <div class="explanation-body">
          <p class="answer-label">Gabarito: {module.answer === 'C' ? 'Certo' : 'Errado'}</p>
          <p>{module.comment}</p>
        </div>
      </details>
      <button type="button" class="retry" data-retry hidden>Responder novamente</button>
    </article>
  ))}
  <p class="sample-note">Uma questão de cada módulo, retirada do PDF. No material completo, o gabarito e o comentário já acompanham cada item.</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-apostila-sample]').forEach((sample) => {
    const selectors = [...sample.querySelectorAll<HTMLButtonElement>('[data-subject]')];
    const questions = [...sample.querySelectorAll<HTMLElement>('[data-question]')];
    selectors.forEach((selector) => {
      selector.hidden = false;
      selector.addEventListener('click', () => {
        selectors.forEach((other) => other.setAttribute('aria-pressed', String(other === selector)));
        questions.forEach((question) => { question.hidden = question.dataset.question !== selector.dataset.subject; });
      });
    });
    questions.forEach((question, i) => {
      question.hidden = i !== 0;
      question.querySelector<HTMLElement>('.answers')!.hidden = false;
      const buttons = [...question.querySelectorAll<HTMLButtonElement>('[data-answer-choice]')];
      const result = question.querySelector<HTMLElement>('.result')!;
      const details = question.querySelector<HTMLDetailsElement>('details')!;
      const retry = question.querySelector<HTMLButtonElement>('[data-retry]')!;
      buttons.forEach((button) => button.addEventListener('click', () => {
        if (buttons.some((other) => other.disabled)) return;
        const correct = button.dataset.answerChoice === question.dataset.answer;
        buttons.forEach((other) => {
          other.disabled = true;
          other.setAttribute('aria-pressed', String(other === button));
          other.classList.toggle('is-correct', other.dataset.answerChoice === question.dataset.answer);
          other.classList.toggle('is-wrong', other === button && !correct);
        });
        result.textContent = correct ? 'Você acertou! Confira o raciocínio no comentário.' : 'Ainda não foi desta vez. O comentário explica a resposta.';
        result.dataset.correct = String(correct);
        details.open = true;
        retry.hidden = false;
      }));
      retry.addEventListener('click', () => {
        buttons.forEach((button) => {
          button.disabled = false;
          button.classList.remove('is-correct', 'is-wrong');
          button.setAttribute('aria-pressed', 'false');
        });
        result.textContent = '';
        delete result.dataset.correct;
        details.open = false;
        retry.hidden = true;
        buttons[0].focus();
      });
    });
  });
</script>

<style>
  [hidden] { display: none !important; }
  .sample { color: #1b2b47; }
  .sample-picker { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px; }
  .sample-picker:has(button[hidden]):not(:has(button:not([hidden]))) { display: none; }
  button { font: inherit; cursor: pointer; }
  .subject { padding: 10px 17px; border: 1px solid #ccd5e4; border-radius: 999px; background: transparent; color: #40516b; font-size: .88rem; font-weight: 600; }
  .subject:hover { border-color: #1e5ec6; }
  .subject[aria-pressed='true'] { color: #fff; background: #153666; border-color: #153666; }
  .question { border: 1px solid #dce3ef; border-radius: 20px; background: #fff; padding: clamp(22px, 4vw, 40px); box-shadow: 0 12px 35px #142d4e08; }
  .question + .question { margin-top: 20px; }
  .question[hidden] + .question { margin-top: 0; }
  .question-top { display: flex; justify-content: space-between; gap: 12px; font-size: .78rem; color: #4e617e; margin-bottom: 20px; }
  .question-top span:first-child { color: #1a5bbe; font-weight: 700; }
  h3 { color: #132c50; font-size: 1.35rem; }
  .source { color: #586a83; font-size: .8rem; margin: 10px 0 20px; }
  .statement { font-size: clamp(1rem, 1.5vw, 1.12rem); line-height: 1.75; margin: 0 0 24px; }
  .answers { display: flex; gap: 12px; }
  .answers button { display: flex; align-items: center; justify-content: center; gap: 12px; flex: 1; min-height: 56px; color: #1b2b47; background: #f7f9fc; border: 1px solid #c9d3e3; border-radius: 10px; font-weight: 600; }
  .answers button span { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 6px; background: #e6ecf5; font-size: .8rem; }
  .answers button:hover:not(:disabled) { border-color: #1e5ec6; background: #eef4ff; }
  .answers button:disabled { cursor: default; opacity: 1; }
  .answers button.is-correct { border-color: #17804d; background: #eaf7ef; color: #116338; }
  .answers button.is-wrong { border-color: #b52a3a; background: #fff0f1; color: #9a2030; }
  .result { margin: 18px 0 0; font-weight: 600; font-size: .94rem; color: #963044; }
  .result:empty { display: none; }
  .result[data-correct='true'] { color: #166438; }
  .explanation { margin-top: 20px; border-top: 1px solid #e1e7ef; padding-top: 18px; }
  summary { cursor: pointer; color: #1759b9; font-weight: 600; font-size: .9rem; min-height: 28px; }
  .explanation-body { padding: 16px 20px; background: #f0f5fc; border-radius: 8px; margin-top: 12px; font-size: .95rem; line-height: 1.7; }
  .explanation-body p { margin: 0; }
  .explanation-body .answer-label { font-weight: 700; color: #142f57; margin-bottom: 6px; }
  .retry { border: 0; border-bottom: 1px solid currentColor; padding: 5px 0; margin-top: 16px; background: transparent; color: #1759b9; font-size: .86rem; }
  .sample-note { color: #596a80; font-size: .82rem; line-height: 1.6; margin: 16px 0 0; }
  button:focus-visible, summary:focus-visible { outline: 3px solid #1763cf; outline-offset: 4px; }
  @media (max-width: 420px) { .subject { padding: 9px 12px; font-size: .8rem; } }
</style>
