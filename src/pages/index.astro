---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import FeaturedGrid from '../components/FeaturedGrid.astro';
import Pagination from '../components/Pagination.astro';
import { isPublished, sortByActivity } from '../utils/posts';

const PER_PAGE = 9;
const page = Number(Astro.props.page ?? 1);
const all = sortByActivity(await getCollection('blog', isPublished));
const featured = page === 1 ? all.slice(0, 3) : [];
const gridAll = all.slice(3);
const totalPages = Math.max(1, Math.ceil(gridAll.length / PER_PAGE));
const posts = gridAll.slice((page - 1) * PER_PAGE, page * PER_PAGE);
---
<BaseLayout title={page > 1 ? `Informática para Concurso: resumos e simulados - Página ${page}` : "Informática para Concurso: resumos e simulados"} description="Resumos, simulados e o que cai na prova de informática dos concursos, em linguagem simples e direta.">
  <h1 class="visually-hidden">Informática para Concurso</h1>

  {page === 1 && (
  <section class="container featured-wrap">
    <div class="recent-header">
      <div>
        <h2>Em destaque</h2>
        <span class="underline"></span>
      </div>
    </div>
    <FeaturedGrid posts={featured} />
  </section>
  )}

  <section class="container recent">
    <div class="recent-header">
      <div>
        <h2>Últimas publicações</h2>
        <span class="underline"></span>
      </div>
      <a href="/blog">Ver todos →</a>
    </div>
    <div class="grid">
      {posts.map((post, i) => (
        <div class={'item'}>
        <PostCard
          slug={post.id}
          title={post.data.title}
          description={post.data.description}
          category={post.data.category}
          date={post.data.date}
          readingTime={post.data.readingTime}
          image={post.data.image}
          imageAlt={post.data.imageAlt}
          priority={i === 0}
        />
        </div>
      ))}
    </div>
    <Pagination current={page} total={totalPages} />
  </section>
</BaseLayout>


<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .featured-wrap {
    padding-block: 32px 8px;
  }

  .recent {
    padding-block: 48px 40px;
  }

  .recent-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 28px;
  }

  .underline {
    display: block;
    width: 48px;
    height: 4px;
    margin-top: 10px;
    border-radius: 2px;
    background: linear-gradient(135deg, var(--violet), var(--rose));
  }

  .recent-header a {
    text-decoration: none;
    color: var(--teal);
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .item {
    display: contents;
  }

  .item.extra:not(.show) {
    display: none;
  }

  .more-wrap {
    display: flex;
    justify-content: center;
    margin-top: 40px;
  }

  .more-btn {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.95rem;
    padding: 12px 28px;
    border-radius: 999px;
    border: 0;
    color: #fff;
    cursor: pointer;
    background: linear-gradient(135deg, var(--violet), var(--rose));
    transition: transform 0.15s ease, filter 0.15s ease;
  }

  .more-btn:hover {
    transform: translateY(-2px);
    filter: brightness(1.1);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

</style>

