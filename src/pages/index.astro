---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Pagination from '../components/Pagination.astro';
import SectionHead from '../components/SectionHead.astro';
import SubjectGrid from '../components/SubjectGrid.astro';
import CompactList from '../components/CompactList.astro';
import { categories, categoryHref } from '../data/categories';
import { isPublished, sortByActivity } from '../utils/posts';
import { questionCount } from '../utils/quizzes';

// Page 1 opens with the subjects of the exam syllabus; "Aulas recentes" and the /page/N/ pages
// list every post, newest first, 9 per page.
const PER_PAGE = 9;
const page = Number(Astro.props.page ?? 1);
const all = sortByActivity(await getCollection('blog', isPublished));
const totalPages = Math.max(1, Math.ceil(all.length / PER_PAGE));
const posts = all.slice((page - 1) * PER_PAGE, page * PER_PAGE);

// Categories that are not a syllabus subject get their own blocks instead.
const NOT_SUBJECTS = ['Concursos', 'Dicas', 'Simulados'];
const inCategory = (name: string) => all.filter((p) => p.data.category === name);
const subjects = categories
  .filter((c) => !NOT_SUBJECTS.includes(c.name))
  .map((c) => {
    const subjectPosts = inCategory(c.name);
    return {
      name: c.name,
      href: categoryHref(c.name),
      posts: subjectPosts,
      questions: subjectPosts.reduce((n, p) => n + questionCount(p.id), 0),
    };
  })
  .filter((s) => s.posts.length > 0)
  .sort((a, b) => b.posts.length - a.posts.length);

const lessons = subjects.reduce((n, s) => n + s.posts.length, 0);
const questions = all.reduce((n, p) => n + questionCount(p.id), 0);
const simulados = inCategory('Simulados');
const concursos = inCategory('Concursos');
---
<BaseLayout title={page > 1 ? `Informática para Concurso: resumos e simulados - Página ${page}` : "Informática para Concurso: resumos e simulados"} description="Resumos, simulados e o que cai na prova de informática dos concursos, em linguagem simples e direta.">
  {page === 1 ? (
    <>
      <section class="container intro">
        <h1>Informática para concurso, matéria por matéria</h1>
        <p class="lede">
          {lessons} aulas sobre o que as bancas cobram, divididas pelas matérias do edital, e {questions} questões comentadas para treinar.
        </p>
        <SubjectGrid subjects={subjects} />
      </section>

      <div class="container pair">
        {simulados.length > 0 && (
          <section>
            <SectionHead title="Simulados" href={categoryHref('Simulados')} linkLabel={`Ver os ${simulados.length}`} />
            <CompactList posts={simulados.slice(0, 5)} />
          </section>
        )}
        {concursos.length > 0 && (
          <section>
            <SectionHead title="Concursos e editais" href={categoryHref('Concursos')} linkLabel={`Ver os ${concursos.length}`} />
            <CompactList posts={concursos.slice(0, 5)} />
          </section>
        )}
      </div>
    </>
  ) : (
    <h1 class="visually-hidden">Informática para Concurso</h1>
  )}

  <section class="container recent">
    <SectionHead title={page === 1 ? 'Aulas recentes' : `Todas as aulas, página ${page}`} href={page === 1 ? '/blog' : undefined} linkLabel="Ver todas" />
    <div class="grid">
      {posts.map((post, i) => (
        <PostCard
          slug={post.id}
          title={post.data.title}
          description={post.data.description}
          category={post.data.category}
          date={post.data.date}
          readingTime={post.data.readingTime}
          image={post.data.image}
          imageAlt={post.data.imageAlt}
          priority={page > 1 && i === 0}
        />
      ))}
    </div>
    <Pagination current={page} total={totalPages} />
  </section>
</BaseLayout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .intro {
    padding-block: 44px 24px;
  }

  h1 {
    max-width: 18ch;
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.04;
  }

  .lede {
    max-width: 56ch;
    margin: 16px 0 32px;
    font-size: 1.08rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px;
    padding-block: 32px 16px;
  }

  .recent {
    padding-block: 40px 56px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px 24px;
  }

  @media (max-width: 860px) {
    .pair {
      grid-template-columns: minmax(0, 1fr);
    }

    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
  }
</style>
