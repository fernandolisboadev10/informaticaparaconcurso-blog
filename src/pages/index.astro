---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import LessonRow from '../components/LessonRow.astro';
import Pagination from '../components/Pagination.astro';
import SectionHead from '../components/SectionHead.astro';
import TrendBar from "../components/TrendBar.astro";
import HomeLead from "../components/HomeLead.astro";
import LatestList from "../components/LatestList.astro";
import SubjectGrid from '../components/SubjectGrid.astro';
import CompactList from '../components/CompactList.astro';
import { categories, categoryHref } from '../data/categories';
import { isPublished, sortByActivity } from '../utils/posts';
import { questionCount } from '../utils/quizzes';
import ApostilaBanner from '../components/ApostilaBanner.astro';
import QuestionPhoneDemo from '../components/QuestionPhoneDemo.astro';
import { QUESTOES_URL, questoesAriaLabel } from '../data/questoes';

// Page 1 opens with the subjects of the exam syllabus; "Aulas recentes" and the /page/N/ pages
// list every post, newest first, 9 per page.
const PER_PAGE = 9;
const page = Number(Astro.props.page ?? 1);
const all = sortByActivity(await getCollection('blog', isPublished));
// Topo da home: ordem por data de criação (o mais novo publicado), não por edição.
const byCreated = [...all].sort((a, b) => b.data.date.getTime() - a.data.date.getTime() || a.id.localeCompare(b.id));
const totalPages = Math.max(1, Math.ceil(all.length / PER_PAGE));
const posts = all.slice((page - 1) * PER_PAGE, page * PER_PAGE);

// Categories that are not a syllabus subject get their own blocks instead.
const NOT_SUBJECTS = ['Concursos', 'Dicas'];
const inCategory = (name: string) => all.filter((p) => p.data.category === name);
const subjects = categories
  .filter((c) => !NOT_SUBJECTS.includes(c.name))
  .map((c) => {
    const subjectPosts = inCategory(c.name);
    return {
      name: c.name,
      href: categoryHref(c.name),
      posts: subjectPosts,
      questions: subjectPosts.reduce((n, p) => n + questionCount(p.id), 0),
    };
  })
  .filter((s) => s.posts.length > 0)
  .sort((a, b) => b.posts.length - a.posts.length);

const lessons = subjects.reduce((n, s) => n + s.posts.length, 0);
const questions = all.reduce((n, p) => n + questionCount(p.id), 0);
// Os simulados agora ficam na categoria do assunto; a home os reúne pelo prefixo do slug.
const simulados = all.filter((p) => p.id.startsWith('simulado-'));
const concursos = inCategory('Concursos');

// Post em destaque no topo: o simulado Cebraspe (cai de volta para o mais recente).
const featured = all.find((p) => p.id === 'simulado-cebraspe-informatica') ?? all[0];
const fmtLong = (d: Date) => d.toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

// "Por onde começar": três passos, na ordem em que o leitor deve percorrer.
const trilhaSlugs = ['como-estudar-informatica-para-concurso', 'nocoes-de-informatica', 'simulado-cebraspe-informatica'];
const trilha = trilhaSlugs
  .map((slug) => all.find((p) => p.id === slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p))
  .map((p) => ({
    slug: p.id,
    title: p.data.title,
    image: p.data.image,
    imageAlt: p.data.imageAlt,
    meta: [p.data.readingTime, questionCount(p.id) > 0 ? `${questionCount(p.id)} questões` : ''].filter(Boolean).join(' · '),
  }));

---
<BaseLayout title={page > 1 ? `Informática para Concurso: resumos e simulados - Página ${page}` : "Informática para Concurso: resumos e simulados"} description="Resumos, simulados e o que cai na prova de informática dos concursos, em linguagem simples e direta.">
  {page > 1 && <h1 class="visually-hidden">Informática para Concurso</h1>}

  {page === 1 && (
    <>
      <h1 class="visually-hidden">Informática para Concurso: resumos e simulados</h1>
      <TrendBar posts={byCreated.slice(0, 6)} />
      <section class="top">
        <div class="top-lead"><HomeLead posts={byCreated.slice(0, 1)} /></div>
        <aside class="top-latest" aria-labelledby="latest-title">
          <SectionHead title="Últimas" id="latest-title" />
          <LatestList posts={byCreated.slice(1, 10)} />
        </aside>
      </section>
    </>
  )}

  {page === 1 && (
    <section class="block promo-hero">
      <ApostilaBanner slot="home-topo" variant="hero" />
    </section>
  )}

  {page === 1 && trilha.length > 0 && (
      <section class="block" id="trilha">
        <div class="block-head">
          <h2>Por onde começar</h2>
          <p>Três passos para organizar seus estudos antes de mergulhar nas matérias.</p>
        </div>
        <ol class="trilha">
          {trilha.map((t, i) => (
            <li>
              <a class="step" href={`/${t.slug}`}>
                <span class="step-thumb">
                  {t.image && <Image src={t.image} alt={t.imageAlt ?? t.title} width={640} height={400} quality={70} />}
                  <span class="step-star" title="Favorito dos leitores">
                    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
                      <path d="M12 2.5l2.94 5.96 6.58.96-4.76 4.64 1.12 6.55L12 17.52 6.12 20.61l1.12-6.55L2.48 9.42l6.58-.96L12 2.5z" />
                    </svg>
                    <span class="visually-hidden">Favorito dos leitores</span>
                  </span>
                </span>
                <span class="step-info">
                  <span class="step-n">{i + 1}</span>
                  <span class="step-text">
                    <span class="step-title">{t.title}</span>
                    {t.meta && <span class="step-meta">{t.meta}</span>}
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>
  )}

  <section class="block recent">
    <SectionHead title={page === 1 ? 'Aulas recentes' : `Todas as aulas, página ${page}`} href={page === 1 ? '/blog' : undefined} linkLabel="Ver todas" />
    <div class="rows">
      {posts.map((post, i) => (
        <LessonRow
          slug={post.id}
          title={post.data.title}
          category={post.data.category}
          date={post.data.date}
          readingTime={post.data.readingTime}
          image={post.data.image}
          imageAlt={post.data.imageAlt}
          priority={page > 1 && i === 0}
        />
      ))}
    </div>
    <Pagination current={page} total={totalPages} />
  </section>

  {page === 1 && (
    <>
      <section class="block" id="materias">
        <div class="block-head head-row">
          <div>
            <h2>Estude por matéria do edital</h2>
            <p>Cada matéria reúne aulas, simulado e questões comentadas.</p>
          </div>
          <a class="more" href="/blog/">Ver todas as aulas →</a>
        </div>
        <SubjectGrid subjects={subjects} />
      </section>

      <div class="block pair">
        {simulados.length > 0 && (
          <section>
            <SectionHead title="Simulados" href="/blog/?q=simulado" linkLabel={`Ver os ${simulados.length}`} />
            <CompactList posts={simulados.slice(0, 5)} action="Iniciar →" />
          </section>
        )}
        {concursos.length > 0 && (
          <section>
            <SectionHead title="Concursos e editais" href={categoryHref('Concursos')} linkLabel={`Ver os ${concursos.length}`} />
            <CompactList posts={concursos.slice(0, 5)} />
          </section>
        )}
      </div>
    </>
  )}

  {page === 1 && (
    <section class="block band-wrap">
      <div class="band" data-banner="gerador" data-slot="home-gerador" data-question-demo-banner>
        <div class="band-text">
          <p class="band-eyebrow"><span class="band-dot" aria-hidden="true"></span>Gerador de Questões com IA</p>
          <h2>Crie questões personalizadas para o seu edital.</h2>
          <p class="band-lede">Gere questões de acordo com o conteúdo programático do seu edital, no estilo da sua banca, e confira o gabarito comentado.</p>
          <ul class="band-chips" aria-label="O que você escolhe">
            <li>Seu edital</li>
            <li>Sua banca</li>
            <li>Nível de dificuldade</li>
            <li>Gabarito comentado</li>
          </ul>
          <a class="btn-cta btn-big" href={QUESTOES_URL} target="_blank" rel="noopener" data-banner-link aria-label={`Criar questões: ${questoesAriaLabel}`}>
            Criar questões
            <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </a>
        </div>
        <QuestionPhoneDemo />
      </div>
    </section>
  )}
</BaseLayout>

<script>
  // Medição do banner do gerador no GA4 (banner_view e banner_click).
  declare const gtag: (...args: unknown[]) => void;
  const bandBox = document.querySelector<HTMLElement>('[data-banner="gerador"]');
  if (bandBox) {
    const send = (name: string) => {
      try { gtag('event', name, { banner_id: 'gerador', slot: bandBox.dataset.slot }); } catch { /* sem analytics */ }
    };
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) { send('banner_view'); io.disconnect(); }
      }, { threshold: 0.5 });
      io.observe(bandBox);
    }
    bandBox.querySelector('[data-banner-link]')?.addEventListener('click', () => send('banner_click'));
  }

</script>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Larguras do design: conteúdo em 1180px com 24px de margem. */
  .hero,
  .block {
    max-width: 1180px;
    margin-inline: auto;
    padding-inline: 24px;
  }

  .block {
    padding-block: 40px 24px;
  }

  .block.promo-hero {
    padding-block: 8px 0;
  }

  .hero {
    padding-block: 64px 48px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr));
    gap: 48px;
    align-items: start;
  }

  .hero-main {
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
  }

  .eyebrow {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--violet);
  }

  h1 {
    font-size: clamp(2.375rem, 5.2vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.04;
    text-wrap: balance;
  }

  .lede {
    max-width: 520px;
    margin: 0;
    font-size: 1.1875rem;
    line-height: 1.6;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .btn-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 28px;
    border-radius: 12px;
    background: var(--cta);
    color: var(--cta-ink);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.0625rem;
    text-decoration: none;
  }

  .btn-cta:hover {
    filter: brightness(1.08);
  }

  /* Brilho neon leve que pulsa devagar (desligado para quem prefere menos movimento). */
  @keyframes neon-pulse {
    0%, 100% {
      box-shadow: 0 0 6px color-mix(in srgb, var(--cta) 45%, transparent), 0 0 14px color-mix(in srgb, var(--cta) 25%, transparent);
    }
    50% {
      box-shadow: 0 0 12px color-mix(in srgb, var(--cta) 80%, transparent), 0 0 26px color-mix(in srgb, var(--cta) 45%, transparent);
    }
  }

  .btn-big {
    animation: neon-pulse 2.8s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-big {
      animation: none;
    }
  }

  .btn-big {
    min-height: 56px;
    padding: 0 32px;
    font-size: 1.125rem;
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    padding: 0 24px;
    border-radius: 12px;
    border: 1px solid var(--line-strong);
    color: var(--ink-strong);
    font-weight: 600;
    text-decoration: none;
  }

  .btn-ghost:hover {
    background: var(--surface-2);
    border-color: var(--line-hover);
  }

  .stats {
    margin: 8px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 40px;
  }

  .stats > div {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .stats dt {
    order: 2;
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }

  .stats dd {
    order: 1;
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.75rem;
    color: var(--ink-strong);
  }

  /* Cartão em destaque */
  .featured {
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 18px;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s;
  }

  .featured:hover {
    border-color: var(--line-hover);
  }

  .featured-img {
    display: block;
    aspect-ratio: 16 / 8;
    background: var(--surface-2);
    border-bottom: 1px solid var(--line-strong);
    overflow: hidden;
  }

  .featured-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .featured-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
  }

  .featured-labels {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    font-size: 0.8125rem;
  }

  .badge {
    padding: 2px 8px;
    border-radius: 6px;
    background: var(--cta);
    color: var(--cta-ink);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .featured-cat {
    font-weight: 700;
    color: var(--violet);
  }

  .chip {
    padding: 2px 8px;
    border-radius: 8px;
    border: 1px solid var(--chip-line);
    background: var(--chip-bg);
    color: var(--chip-ink);
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .featured-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.5rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--ink-strong);
    text-wrap: balance;
  }

  .featured-meta {
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }

  .featured-go {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
    color: var(--cta);
  }

  .top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 330px;
    gap: 40px;
    max-width: 1180px;
    margin-inline: auto;
    padding: 36px 24px 24px;
  }

  @media (max-width: 960px) {
    .top { grid-template-columns: minmax(0, 1fr); gap: 32px; }
  }

  /* Blocos de seção */
  .block-head {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 24px;
  }

  .block-head.head-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
  }

  .block-head.head-row > div {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .block-head h2 {
    font-size: 1.875rem;
    font-weight: 800;
    letter-spacing: -0.015em;
  }

  .block-head p {
    margin: 0;
    color: var(--ink-soft);
  }

  .more {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    color: var(--violet);
    text-decoration: none;
  }

  .more:hover {
    color: var(--ink-strong);
  }

  /* Por onde começar */
  .trilha {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: 16px;
  }

  .step {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s;
  }

  .step-thumb {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    background: var(--surface-2);
    border-bottom: 1px solid var(--line-strong);
    overflow: hidden;
  }

  .step-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .step-info {
    display: flex;
    gap: 16px;
    padding: 20px;
  }

  /* Estrela dourada: marca os artigos favoritos e mais acessados. */
  .step-star {
    position: absolute;
    top: 10px;
    right: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(10, 14, 22, 0.78);
    border: 1px solid rgba(251, 191, 36, 0.55);
    box-shadow: 0 0 12px rgba(251, 191, 36, 0.4);
    backdrop-filter: blur(4px);
  }

  .step-star svg {
    fill: #fbbf24;
    stroke: #f59e0b;
    stroke-width: 1;
    stroke-linejoin: round;
    filter: drop-shadow(0 0 3px rgba(251, 191, 36, 0.6));
  }

  .step:hover {
    border-color: var(--line-hover);
  }

  .step-n {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: var(--surface-2);
    color: var(--violet);
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .step-text {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .step-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    line-height: 1.3;
    color: var(--ink-strong);
    text-wrap: balance;
  }

  .step-meta {
    font-size: 0.875rem;
    color: var(--ink-soft);
  }

  .pair {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(480px, 100%), 1fr));
    gap: 48px;
  }

  .rows {
    border-top: 1px solid var(--line);
  }

  .rows > :global(.row + .row) {
    border-top: 1px solid var(--line);
  }

  .rows > :global(.row) {
    border-bottom: 0;
  }

  .recent {
    padding-bottom: 8px;
  }

  /* Faixa final: gerador de questões. Azul profundo com destaques em azul neon. */
  .band-wrap {
    padding-block: 48px 72px;
  }

  .band {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: 40px;
    align-items: center;
    padding: 44px;
    border-radius: 24px;
    border: 2px solid #38aaff;
    color: #fff;
    background:
      radial-gradient(circle at 100% 0%, rgba(56, 170, 255, 0.16), transparent 50%),
      linear-gradient(135deg, #071326 0%, #0c2442 100%);
    box-shadow: 0 0 22px rgba(56, 170, 255, 0.3);
  }

  .band-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    min-width: 0;
    position: relative;
    z-index: 2;
  }

  .band-eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #93ceff;
  }

  .band-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #38aaff;
  }

  .band-text h2 {
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: #fff;
    text-wrap: balance;
  }

  .band-lede {
    margin: 0;
    max-width: 560px;
    font-size: 1.0625rem;
    color: #c5d6ea;
    text-wrap: pretty;
  }

  .band-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 4px 0 8px;
    padding: 0;
  }

  .band-chips li {
    padding: 5px 14px;
    border-radius: 999px;
    border: 1px solid rgba(56, 170, 255, 0.5);
    background: rgba(56, 170, 255, 0.08);
    color: #bbdfff;
    font-size: 0.875rem;
    font-weight: 600;
  }

  /* Botão: azul neon com texto escuro */
  .band .btn-cta {
    background: #38aaff;
    color: #071426;
    box-shadow: 0 0 10px rgba(56, 170, 255, 0.45);
  }

  .band .btn-cta svg {
    transition: transform 0.2s;
  }

  .band .btn-cta:hover {
    background: #93ceff;
    filter: none;
  }

  .band .btn-cta:hover svg {
    transform: translateX(4px);
  }

  .band .btn-cta:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }

  @media (max-width: 900px) {
    .band {
      grid-template-columns: minmax(0, 1fr);
      padding: 32px 24px;
    }

    .band .btn-cta {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-block: 40px 32px;
      gap: 32px;
    }

  }
</style>
