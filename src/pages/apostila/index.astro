---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ApostilaSample from '../../components/ApostilaSample.astro';
import SalesArrow from '../../components/SalesArrow.astro';
import ApostilaCheckout from '../../components/ApostilaCheckout.astro';
import { PAYMENTS_UI_ENABLED } from '../../data/payments';
import { APOSTILA_COVER, APOSTILA_PRICE, APOSTILA_QUESTIONS } from '../../data/apostila';
import { apostilaModules } from '../../data/apostila-samples';
import sistemas from '../../assets/apostila/pagina-3.webp';
import documentos from '../../assets/apostila/pagina-39.webp';
import redes from '../../assets/apostila/pagina-106.webp';
import informacoes from '../../assets/apostila/pagina-161.webp';
import seguranca from '../../assets/apostila/pagina-165.webp';

const previews = [sistemas, documentos, redes, informacoes, seguranca];
const bookSchema = {
  '@context': 'https://schema.org', '@type': 'Book',
  name: 'Apostila Cebraspe: 552 Questões Comentadas de Informática',
  description: '552 questões de provas Cebraspe, com gabarito comentado, em cinco módulos de Informática. PDF com 206 páginas.',
  author: { '@type': 'Person', name: 'Fernando Lisboa' },
  bookFormat: 'https://schema.org/EBook', numberOfPages: 206, inLanguage: 'pt-BR',
  image: new URL(APOSTILA_COVER, Astro.site).href,
  url: new URL('/apostila/', Astro.site).href,
  isAccessibleForFree: false,
};
const faqs = [
  { question: 'O que está incluído na apostila?', answer: 'Um arquivo PDF com 206 páginas e 552 questões de provas Cebraspe já aplicadas. Cada questão tem gabarito e comentário. O conteúdo está dividido em cinco módulos, apresentados nesta página.' },
  { question: 'É uma apostila de teoria ou de questões?', answer: 'O foco é o treino por questões. Os comentários ajudam a entender as respostas e revisar os conceitos envolvidos. Para complementar a teoria, você pode continuar usando gratuitamente as aulas do blog.' },
  { question: 'A apostila funciona como este teste interativo?', answer: 'A interação é uma demonstração desta página. A apostila é um PDF: os gabaritos e os comentários já aparecem junto das questões, como nas páginas de amostra.' },
  { question: 'Posso ler no celular e no computador?', answer: 'Sim. Você pode abrir o PDF em um leitor compatível no celular, tablet ou computador. O material usa páginas A4; no celular, pode ser necessário ampliar o texto para ler com conforto.' },
  { question: 'Posso imprimir para estudar?', answer: 'Sim, o formato A4 permite imprimir o material para seu estudo pessoal. Você também pode estudar diretamente pelo arquivo digital.' },
  PAYMENTS_UI_ENABLED
    ? { question: 'Como faço o pagamento?', answer: 'Informe seu e-mail na área da oferta para continuar no Checkout Pro do Mercado Pago. O preço é R$ 27,90, em pagamento único. As opções de Pix e cartão são apresentadas no checkout.' }
    : { question: 'Já posso comprar por esta página?', answer: 'Ainda não. A compra por esta página está em preparação. O preço apresentado é R$ 27,90, em pagamento único. Por enquanto, você pode experimentar as questões e conhecer páginas reais da apostila gratuitamente.' },
  { question: 'A apostila é uma publicação oficial da Cebraspe?', answer: 'Não. É um material de estudo independente, organizado por Fernando Lisboa, do Informática para Concurso, com questões de provas da banca e comentários explicativos.' },
];
---
<BaseLayout
  title="Apostila Cebraspe"
  seoTitle="Apostila Cebraspe: 552 questões comentadas de Informática"
  description="Conheça a apostila de Informática com 552 questões Cebraspe comentadas, 206 páginas e cinco módulos. Experimente uma amostra gratuita. R$ 27,90."
  image={APOSTILA_COVER}
  showSiteNavigation={false}
  ads={false}
>
  <script type="application/ld+json" set:html={JSON.stringify(bookSchema)} />
  <div class="sales">
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <header class="sales-header">
      <div class="wrap header-inner">
        <a class="brand" href="/" aria-label="Informática para Concurso — início">
          <img src="/images/logo-icon.webp" width="34" height="34" alt="" />
          <span>Informática<small>para Concurso</small></span>
        </a>
        <nav aria-label="Conheça a apostila">
          <a href="#amostra">Experimentar</a>
          <a href="#modulos">Conteúdo</a>
          <a class="back-blog" href="/">Voltar ao blog <SalesArrow direction="diagonal" /></a>
        </nav>
      </div>
    </header>

    <section class="hero" id="conteudo" aria-labelledby="hero-title">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="product-label"><span aria-hidden="true"></span> Sua próxima sessão de estudo começa aqui</p>
          <h1 id="hero-title">552 questões Cebraspe.<br />Entenda o porquê de cada resposta.</h1>
          <p class="hero-description">Transforme questões de provas em revisão de verdade. Treine Informática com gabaritos comentados e matérias organizadas para estudar no seu ritmo.</p>
          <div class="hero-offer"><strong>{APOSTILA_PRICE}</strong><span>Pagamento único<br />Apostila digital em PDF</span></div>
          <div class="hero-actions">
            <a class="action primary sample-cta" href="#amostra">Experimentar uma questão <SalesArrow direction="down" /></a>
            <a class="text-link" href="#oferta">Conhecer a oferta <SalesArrow /></a>
          </div>
          <p class="hero-footnote">Amostra gratuita, sem cadastro. Veja o material antes de decidir.</p>
        </div>
        <div class="book-stage">
          <div class="page-behind" aria-hidden="true">
            <Image src={sistemas} alt="" width={340} loading="eager" />
          </div>
          <div class="book">
            <img src={APOSTILA_COVER} width="1086" height="1448" alt="Capa da apostila Questões Cebraspe de Informática, com gabarito comentado" fetchpriority="high" />
          </div>
          <a class="page-invite" href="#por-dentro"><span class="page-icon" aria-hidden="true">▤</span><span>Abra a apostila<small>Veja páginas reais do PDF</small></span><SalesArrow direction="diagonal" /></a>
        </div>
      </div>
      <dl class="wrap facts">
        <div><dt>Questões de provas</dt><dd>{APOSTILA_QUESTIONS}</dd></div>
        <div><dt>Páginas de estudo</dt><dd>206</dd></div>
        <div><dt>Módulos organizados</dt><dd>5</dd></div>
        <div><dt>Em cada questão</dt><dd class="fact-text">Gabarito + comentário</dd></div>
      </dl>
    </section>

    <section class="section sample-section" id="amostra" aria-labelledby="sample-heading">
      <div class="wrap sample-grid">
        <div class="section-intro">
          <p class="section-label">Experimente antes</p>
          <h2 id="sample-heading">Na Cebraspe,<br />um detalhe muda a resposta.</h2>
          <p>Leia o item, escolha Certo ou Errado e confira o comentário. É assim que uma questão vira aprendizado.</p>
          <p class="small-note">São cinco questões gratuitas, uma por módulo. Responda no seu ritmo e veja seu resultado ao final.</p>
          <a class="inline-link" href="#por-dentro">Prefere ver as páginas do PDF? <SalesArrow direction="down" /></a>
        </div>
        <ApostilaSample />
      </div>
    </section>

    <section class="section modules-section" id="modulos" aria-labelledby="modules-heading">
      <div class="wrap">
        <div class="section-heading"><div><p class="section-label">Seu roteiro de revisão</p><h2 id="modules-heading">Cinco módulos.<br />Um material para voltar sempre.</h2></div><p>Vá direto à matéria que precisa revisar. As questões estão agrupadas por módulo, com a identificação da prova e o comentário junto de cada item.</p></div>
        <div class="modules">
          {apostilaModules.map((module) => (
            <a class="module" href="#amostra" data-try-module={module.id} aria-label={`Experimentar uma questão de ${module.name}`}>
              <span class="module-count">{module.count}<small>questões</small></span>
              <div><h3>{module.name}</h3><p>{module.description}</p></div>
              <span class="module-arrow"><SalesArrow direction="diagonal" /></span>
            </a>
          ))}
        </div>
        <p class="module-total"><strong>552 questões no total.</strong> Clique em uma matéria para experimentar sua amostra.</p>
      </div>
    </section>

    <section class="section preview-section" id="por-dentro" aria-labelledby="preview-heading">
      <div class="wrap">
        <div class="section-heading"><div><p class="section-label">Sem precisar imaginar</p><h2 id="preview-heading">A apostila, por dentro.</h2></div><p>Estas são páginas do material que você vai estudar. Amplie para conferir a organização das questões, os gabaritos e os comentários.</p></div>
        <div class="preview-grid">
          {apostilaModules.map((module, i) => (
            <a class="preview" href={previews[i].src} target="_blank" rel="noopener" data-preview data-index={i} data-title={module.name} data-page={module.page} aria-label={`Ampliar página ${module.page}: ${module.name} (imagem)`}>
              <div class="preview-image"><Image src={previews[i]} alt={`Página ${module.page} da apostila: questões e comentários de ${module.name}`} width={320} widths={[240, 400, 640]} sizes="(max-width: 600px) 68vw, (max-width: 900px) 35vw, 200px" loading="lazy" /><span aria-hidden="true">Ampliar <SalesArrow direction="diagonal" /></span></div>
              <h3>{module.short}</h3><p>Página {module.page}</p>
            </a>
          ))}
        </div>
        <p class="preview-note">Amostra de cinco páginas. O arquivo completo tem 206 páginas em formato A4.</p>
      </div>
    </section>

    <section class="section study-section" aria-labelledby="study-heading">
      <div class="wrap study-grid">
        <div><p class="section-label">Mais que conferir um gabarito</p><h2 id="study-heading">Responda.<br />Entenda.<br />Retome o que errou.</h2><p class="study-intro">Uma forma simples de encaixar a apostila na sua rotina, junto das aulas e do seu edital.</p></div>
        <ol class="study-steps">
          <li><span>1</span><div><h3>Escolha a matéria da vez</h3><p>Use o sumário para localizar o módulo que combina com a sua revisão.</p></div></li>
          <li><span>2</span><div><h3>Tente antes de conferir</h3><p>Leia o enunciado e formule sua resposta antes de olhar o gabarito que acompanha a questão.</p></div></li>
          <li><span>3</span><div><h3>Volte ao raciocínio</h3><p>Leia o comentário e anote o que confundiu você. Na próxima sessão, comece por esses pontos.</p></div></li>
        </ol>
      </div>
    </section>

    <section class="section author-section" aria-labelledby="author-heading">
      <div class="wrap author-grid">
        <div class="author-photo"><img src="/images/fernando-lisboa.png" width="240" height="240" loading="lazy" alt="Fernando Lisboa, autor do Informática para Concurso" /></div>
        <div><p class="section-label">Quem organiza o seu estudo</p><h2 id="author-heading">Olá, eu sou Fernando Lisboa.</h2><p>Sou professor de Informática, formado em Análise e Desenvolvimento de Sistemas e responsável pelo Informática para Concurso.</p><p>Meu trabalho é ajudar você a estudar com conteúdo prático e uma linguagem que faça sentido. A apostila reúne questões de provas Cebraspe com comentários para apoiar sua revisão.</p><a class="inline-link" href="/sobre-nos/">Conheça meu trabalho no blog <SalesArrow direction="diagonal" /></a></div>
      </div>
    </section>

    <section class="section offer-section" id="oferta" aria-labelledby="offer-heading">
      <div class="wrap offer-grid">
        <div>
          <p class="section-label">Seu próximo material de revisão</p>
          <h2 id="offer-heading">Tudo isso,<br />em uma apostila.</h2>
          <ul class="included">
            <li><span aria-hidden="true">✓</span> 552 questões de provas Cebraspe já aplicadas</li>
            <li><span aria-hidden="true">✓</span> Gabarito e comentário em cada questão</li>
            <li><span aria-hidden="true">✓</span> Cinco módulos de Informática</li>
            <li><span aria-hidden="true">✓</span> 206 páginas em PDF, formato A4</li>
            <li><span aria-hidden="true">✓</span> Para ler em um dispositivo ou imprimir</li>
          </ul>
          <p class="independent">Material independente. Não é uma publicação oficial da Cebraspe.</p>
        </div>
        <div class="offer-card">
          <p class="offer-name">Apostila Cebraspe de Informática</p>
          <p class="price">{APOSTILA_PRICE}</p>
          <p class="payment-note">Pagamento único · Produto digital</p>
          {PAYMENTS_UI_ENABLED ? <ApostilaCheckout /> : <>
            <div class="availability"><span aria-hidden="true"></span> Compra disponível em breve</div>
            <p class="availability-note">Estamos preparando a compra por esta página. Enquanto isso, conheça o material com a amostra gratuita.</p>
            <a class="action primary" href="#amostra">Experimentar a amostra <SalesArrow direction="up" /></a>
          </>}
          <a class="support-link" href="mailto:fernandolisboa.dev@gmail.com">Tem uma dúvida? Fale comigo</a>
        </div>
      </div>
    </section>

    <section class="section faq-section" aria-labelledby="faq-heading">
      <div class="wrap faq-grid"><div><p class="section-label">Antes de decidir</p><h2 id="faq-heading">Ficou alguma dúvida?</h2><p>Conheça o formato e o que faz parte do material.</p></div><div class="faq-list">{faqs.map((faq) => (<details><summary>{faq.question}<span aria-hidden="true">+</span></summary><p>{faq.answer}</p></details>))}</div></div>
    </section>

    <footer class="sales-footer">
      <div class="wrap footer-top"><a class="footer-brand" href="/">Informática para Concurso</a><p>O estudo continua no blog.<br /><a href="/questoes/">Pratique com as questões gratuitas <SalesArrow direction="diagonal" /></a></p></div>
      <div class="wrap footer-bottom"><p>© {new Date().getFullYear()} Informática para Concurso</p><nav aria-label="Informações legais"><a href="/politica-de-privacidade/">Privacidade</a><a href="/politica-de-cookies/">Cookies</a><a href="#" data-open-cookie-settings>Configurações de cookies</a><a href="/fale-conosco/">Contato</a></nav></div>
    </footer>

    <div class="sticky-offer" hidden><span><strong>{APOSTILA_PRICE}</strong><small>Apostila · 552 questões</small></span><a href="#oferta">Ver oferta <SalesArrow /></a></div>

    <dialog class="preview-dialog" aria-labelledby="dialog-title">
      <div class="dialog-header"><div><p id="dialog-title"></p><span data-dialog-page></span></div><button type="button" data-close aria-label="Fechar prévia">✕</button></div>
      <div class="dialog-image"><img data-dialog-image src={sistemas.src} width={sistemas.width} height={sistemas.height} alt="" loading="lazy" /></div>
      <div class="dialog-controls"><button type="button" data-prev aria-label="Ver página de amostra anterior">← Anterior</button><span data-dialog-counter></span><button type="button" data-next aria-label="Ver próxima página de amostra">Próxima →</button></div>
    </dialog>
  </div>
</BaseLayout>

<script>
  // Reveal selected content once as it enters the viewport; all content is visible without JS.
  const sales = document.querySelector<HTMLElement>('.sales');
  if (sales && 'IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const reveal = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.remove('effect-pending');
        reveal.unobserve(entry.target);
      });
    }, { threshold: .12 });
    sales.querySelectorAll('.section-heading, .study-steps, .author-grid, .offer-card').forEach((element) => {
      element.classList.add('effect-reveal', 'effect-pending');
      reveal.observe(element);
    });
  }

  // Link each module to its sample. Plain anchors still work without JavaScript.
  document.querySelectorAll<HTMLAnchorElement>('[data-try-module]').forEach((link) => {
    link.addEventListener('click', () => {
      document.querySelector<HTMLButtonElement>(`[data-subject="${link.dataset.tryModule}"]`)?.click();
    });
  });

  const dialog = document.querySelector<HTMLDialogElement>('.preview-dialog');
  const previews = [...document.querySelectorAll<HTMLAnchorElement>('[data-preview]')];
  if (dialog && typeof dialog.showModal === 'function') {
    const image = dialog.querySelector<HTMLImageElement>('[data-dialog-image]')!;
    let active = 0;
    let opener: HTMLElement | null = null;
    const display = (index: number) => {
      active = (index + previews.length) % previews.length;
      const link = previews[active];
      image.src = link.href;
      image.alt = `Página ${link.dataset.page} da apostila: ${link.dataset.title}`;
      dialog.querySelector('#dialog-title')!.textContent = link.dataset.title ?? '';
      dialog.querySelector('[data-dialog-page]')!.textContent = `Página ${link.dataset.page} do PDF`;
      dialog.querySelector('[data-dialog-counter]')!.textContent = `${active + 1} de ${previews.length}`;
      dialog.querySelector('.dialog-image')!.scrollTop = 0;
    };
    previews.forEach((link, index) => link.addEventListener('click', (event) => {
      if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      opener = link;
      display(index);
      dialog.showModal();
      document.documentElement.classList.add('apostila-preview-open');
    }));
    dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-prev]')?.addEventListener('click', () => display(active - 1));
    dialog.querySelector('[data-next]')?.addEventListener('click', () => display(active + 1));
    dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
        event.preventDefault();
        display(active + (event.key === 'ArrowRight' ? 1 : -1));
      }
    });
    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('apostila-preview-open');
      opener?.focus({ preventScroll: true });
    });
  }

  const sticky = document.querySelector<HTMLElement>('.sticky-offer');
  const hero = document.querySelector('.hero');
  const offer = document.querySelector('#oferta');
  if (sticky && hero && offer && 'IntersectionObserver' in window) {
    let heroVisible = true;
    let offerVisible = false;
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.target === hero) heroVisible = entry.isIntersecting;
        if (entry.target === offer) offerVisible = entry.isIntersecting;
      });
      sticky.hidden = heroVisible || offerVisible;
    });
    observer.observe(hero);
    observer.observe(offer);
  }
</script>

<style>
  /* Product palette: the real navy/yellow cover, blue answer accents, white PDF pages. */
  .sales { --navy: #101c34; --paper: #f5f7fb; --blue: #1e5ec6; --yellow: #ffd028; --text: #1b2b47; color-scheme: light; color: var(--text); background: #fff; font-family: var(--f-inter, Arial), sans-serif; }
  .sales :is(h1, h2, h3) { font-family: var(--f-archivo, Arial), sans-serif; color: inherit; letter-spacing: -.035em; }
  .sales :is(a, button, summary):focus-visible { outline: 3px solid #1b75e5; outline-offset: 5px; }
  .sales :is(.hero, .sales-header, .offer-section, .sales-footer) a:focus-visible { outline-color: var(--yellow); }
  .sales :is(section, article)[id] { scroll-margin-top: 24px; }
  .sales [hidden] { display: none !important; }
  .wrap { width: min(1160px, calc(100% - 64px)); margin-inline: auto; }
  .skip-link { position: fixed; top: -80px; left: 16px; z-index: 100; padding: 12px; background: #fff; color: #14233c; }
  .skip-link:focus { top: 12px; }
  .sales-header { background: var(--navy); color: #eaf0fc; }
  .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding-block: 22px; border-bottom: 1px solid #ffffff1a; }
  .brand { display: inline-flex; align-items: center; gap: 10px; color: #fff; text-decoration: none; font-size: 21px; font-weight: 800; line-height: 1.15; letter-spacing: -.025em; }
  .brand img { flex-shrink: 0; }
  .brand small { display: block; font-size: 11px; font-weight: 500; letter-spacing: .09em; margin-top: 3px; color: #c5cee2; }
  .sales-header nav { display: flex; align-items: center; gap: 30px; font-size: .85rem; }
  .sales-header nav a { text-decoration: none; padding-block: 10px; }
  .sales-header nav a:hover { color: var(--yellow); }
  .back-blog { border-left: 1px solid #ffffff26; padding-left: 30px; }
  .hero { position: relative; overflow: hidden; background: var(--navy); color: #fff; }
  .hero-grid { display: grid; grid-template-columns: 1.15fr 1fr; gap: 68px; align-items: center; padding-block: 72px 62px; }
  .product-label { display: flex; align-items: center; gap: 9px; font-size: .8rem; color: #dae3f3; margin: 0 0 24px; }
  .product-label > span { width: 7px; height: 7px; border-radius: 50%; background: var(--yellow); }
  h1 { font-size: clamp(2.25rem, 3.65vw, 3.2rem); line-height: 1.12; font-weight: 800; }
  .hero-description { max-width: 48ch; color: #bfcbe0; font-size: 1.05rem; line-height: 1.8; margin: 24px 0; }
  .hero-offer { display: flex; gap: 18px; align-items: center; margin: 28px 0; }
  .hero-offer strong { font-size: 2.2rem; font-weight: 700; letter-spacing: -.04em; }
  .hero-offer > span { color: #bfcbe0; border-left: 1px solid #ffffff30; padding-left: 18px; font-size: .76rem; line-height: 1.7; }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 22px; }
  @keyframes hero-introduction { from { opacity: .1; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: no-preference) {
    .hero-copy { animation: hero-introduction .55s ease-out both; }
    .book-stage { animation: hero-introduction .75s .12s ease-out both; }
    .effect-reveal { transition: opacity .55s ease-out, transform .55s ease-out; }
    .effect-pending { opacity: 0; transform: translateY(16px); }
    .effect-pending:focus-within { opacity: 1; transform: none; }
    .module { transition: background .2s ease, transform .2s ease; }
    .module:hover, .module:focus-visible { transform: translateX(4px); }
    .preview-image { transition: transform .25s ease, box-shadow .25s ease; }
    .preview:hover .preview-image, .preview:focus-visible .preview-image { transform: translateY(-5px); box-shadow: 0 14px 24px #19396326; }
  }
  .action { display: inline-flex; align-items: center; justify-content: center; gap: 20px; padding: 17px 22px; min-height: 54px; text-decoration: none; border-radius: 9px; font-size: .9rem; font-weight: 700; transition: background .2s; }
  .primary { background: var(--yellow); color: #17223b; }
  .primary:hover { background: #ffe16d; }
  .sample-cta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: #ffda44;
    color: #182238;
    box-shadow: inset 0 1px 0 #fff5, 0 4px 14px #0002;
  }
  .sample-cta:hover, .sample-cta:focus-visible { background: #ffe36b; box-shadow: inset 0 1px 0 #fff6, 0 7px 22px #ffda4438; }
  .sample-cta:active { background: #f5cc32; }
  @keyframes cta-sunlight {
    from { transform: translateX(-350%) skewX(-20deg); }
    to { transform: translateX(500%) skewX(-20deg); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .sample-cta { transition: background .2s ease, box-shadow .2s ease, transform .2s ease; }
    .sample-cta::after {
      content: '';
      position: absolute;
      inset-block: -10%;
      left: 0;
