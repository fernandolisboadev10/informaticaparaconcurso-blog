---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { categories } from '../../data/categories';
import { sortByActivity } from '../../utils/posts';

export async function getStaticPaths() {
  const all = sortByActivity(await getCollection('blog', ({ data }) => !data.draft));
  return categories.map((category) => ({
    params: { slug: category.slug },
    props: { category, posts: all.filter((p) => p.data.category === category.name) },
  }));
}

const { category, posts } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: category.title,
  description: category.description,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  inLanguage: 'pt-BR',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: posts.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(`/${p.id}/`, Astro.site).toString(),
      name: p.data.title,
    })),
  },
};
---
<BaseLayout
  title={category.title}
  description={category.description}
  image={posts[0]?.data.image?.src}
  noindex={posts.length < 2}
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <div class="container">
    <header class="page-header">
      <p class="crumbs"><a href="/blog/">Blog</a> / {category.name}</p>
      <h1>{category.name}</h1>
      <p>{category.intro}</p>
    </header>

    <div class="posts">
      {posts.map((post) => (
        <PostCard
          slug={post.id}
          title={post.data.title}
          description={post.data.description}
          category={post.data.category}
          date={post.data.date}
          readingTime={post.data.readingTime}
          image={post.data.image}
          imageAlt={post.data.imageAlt}
        />
      ))}
    </div>

    <nav class="other" aria-label="Outras categorias">
      {categories
        .filter((c) => c.slug !== category.slug)
        .map((c) => <a href={`/categoria/${c.slug}/`}>{c.name}</a>)}
    </nav>
  </div>
</BaseLayout>

<style>
  .page-header {
    padding-block: 48px 24px;
    max-width: 60ch;
  }

  .crumbs {
    font-size: 0.85rem;
    color: var(--ink-soft);
    margin: 0 0 8px;
  }

  .crumbs a {
    color: var(--violet);
    text-decoration: none;
  }

  .page-header p:not(.crumbs) {
    color: var(--ink-soft);
    margin-top: 8px;
  }

  .posts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    padding-bottom: 16px;
  }

  @media (max-width: 860px) {
    .posts {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .posts {
      grid-template-columns: 1fr;
    }
  }

  .other {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-block: 24px 48px;
  }

  .other a {
    font-size: 0.85rem;
    padding: 8px 14px;
    border-radius: 20px;
    border: 1px solid var(--line);
    color: var(--ink-soft);
    text-decoration: none;
  }

  .other a:hover {
    color: var(--violet);
    border-color: var(--violet);
  }
</style>
