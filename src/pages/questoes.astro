    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .page .comment {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--ink);
    text-wrap: pretty;
  }

  .page .lesson {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    color: var(--violet);
    text-decoration: none;
  }

  .page .lesson:hover {
    color: var(--ink-strong);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .page .nav-btns {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
  }

  .page .btn-ghost {
    min-height: 52px;
    padding: 0 24px;
    border-radius: 12px;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--ink-strong);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
  }

  .page .btn-ghost:hover:not(:disabled) {
    background: var(--surface-2);
    border-color: var(--line-hover);
  }

  .page .btn-ghost:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .page .btn-small {
    min-height: 44px;
    border-radius: 10px;
    font-size: 0.9375rem;
    padding: 0 16px;
  }

  .page .btn-next {
    min-height: 52px;
    padding: 0 28px;
    border-radius: 12px;
    border: 0;
    background: var(--surface-2);
    color: var(--ink-soft);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.0625rem;
    cursor: pointer;
  }

  .page .btn-next.is-ready {
    background: var(--cta);
    color: var(--cta-ink);
  }

  .page .btn-next.is-ready:hover {
    filter: brightness(1.08);
  }

  .page .btn-next:disabled {
    cursor: default;
  }

  .page .side {
    flex: 1 1 280px;
    max-width: 340px;
    min-width: 260px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .page .panel {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 16px;
  }

  .page .panel h2 {
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--violet);
  }

  .page .grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 8px;
  }

  .page .nbtn {
    min-height: 48px;
    border-radius: 10px;
    border: 2px solid var(--line-strong);
    background: var(--bg);
    color: var(--ink-strong);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.9375rem;
    line-height: 1.1;
