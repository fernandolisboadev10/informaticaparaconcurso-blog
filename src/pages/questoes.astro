    color: var(--ink-soft);
  }

  .page .done {
    margin: 0;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    font-size: 0.9375rem;
    color: var(--ink);
  }

  .page .done[hidden] {
    display: none;
  }

  .page .gerador {
    margin: 40px 0 0;
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  .page .gerador a {
    color: var(--violet);
    font-weight: 600;
  }

  .page .nojs {
    color: var(--ink-soft);
  }

  @media (max-width: 640px) {
    .page .card {
      padding: 22px 18px;
    }

    .page .q-text {
      font-size: 1.125rem;
    }

    .page .side {
      max-width: none;
      flex-basis: 100%;
    }
  }
</style>
