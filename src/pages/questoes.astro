    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .page .tag {
    padding: 3px 12px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink-soft);
