    flex-direction: column;
    gap: 12px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .page .feedback[hidden] {
    display: none;
  }

  .page .verdict {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.25rem;
    color: var(--bad);
  }

  .page .verdict.ok {
