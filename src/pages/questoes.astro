  }

  .page .back:hover {
    color: var(--ink-strong);
  }

  .page .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 28px;
  }

  .page .chip {
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--ink);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.875rem;
    cursor: pointer;
  }

  .page .chip:hover {
    background: var(--surface-2);
    border-color: var(--line-hover);
  }

  .page .chip.is-on {
    background: color-mix(in srgb, var(--violet) 18%, var(--bg));
    border-color: var(--violet);
    color: var(--ink-strong);
  }

  .page .layout {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    align-items: flex-start;
  }

  .page .layout[hidden] {
    display: none;
  }

  .page .main {
    flex: 999 1 560px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .page .progress-meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;
    font-size: 0.875rem;
    color: var(--ink-soft);
  }

  .page .progress-meta strong {
    color: var(--ink-strong);
    font-family: var(--font-mono);
  }

  .page .progress {
    height: 6px;
    border-radius: 999px;
    background: var(--surface-2);
    overflow: hidden;
  }

  .page .progress-fill {
    height: 100%;
    width: 0;
    background: var(--cta);
    border-radius: 999px;
