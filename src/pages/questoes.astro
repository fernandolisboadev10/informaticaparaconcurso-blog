  .page .tag-cat {
    border-color: color-mix(in srgb, var(--violet) 40%, transparent);
    color: var(--violet);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .page .q-text {
    margin: 0;
    font-size: 1.25rem;
