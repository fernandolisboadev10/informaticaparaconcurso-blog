---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import AuthorBio from '../components/AuthorBio.astro';
import ShareButtons from '../components/ShareButtons.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import Quiz from '../components/Quiz.astro';
import StudyOffer from '../components/StudyOffer.astro';
import GeneratorAnchor from '../components/GeneratorAnchor.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import type { MarkdownHeading } from 'astro';
import { categoryHref } from '../data/categories';
import { categoryColor } from '../utils/categoryColor';
import { getArticleQuiz } from '../utils/quizzes';

interface Props {
  title: string;
  seoTitle?: string;
  description: string;
  category: string;
  date: Date;
  updated?: Date;
  related?: string[];
  tags?: string[];
  readingTime?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  slug: string;
  prev?: { slug: string; title: string };
  next?: { slug: string; title: string };
  headings?: MarkdownHeading[];
}
const { title, seoTitle, description, category, date, updated, related, tags, readingTime, image, imageAlt, prev, next, headings = [] } = Astro.props;

// Questões interativas ficam em src/data/quizzes/<slug>.json e são exibidas no final do artigo.
const quiz = getArticleQuiz(Astro.props.slug);
const articleOffers: Record<string, { product: 'apostila' | 'gerador'; before: string; label?: string }> = {
  'cebraspe-como-funciona-a-banca-e-o-que-ela-cobra-em-informatica': { product: 'apostila', before: 'Estratégia de estudo' },
  'concurso-policia-civil-cebraspe-informatica': { product: 'apostila', before: 'Por onde começar' },
  'gabarito-extraoficial-pm-ma-soldado': { product: 'apostila', before: 'Como calcular a sua nota' },
  'nocoes-de-informatica': { product: 'gerador', before: 'Os 5 blocos', label: 'Praticar mais questões de Informática' },
  'sistema-windows-7-10-11-para-concursos': { product: 'gerador', before: 'Windows 11', label: 'Praticar mais questões de Windows' },
  'linux-para-concursos': { product: 'gerador', before: 'O escritório dentro do Linux', label: 'Praticar mais questões de Linux' },
  'aplicativos-para-seguranca-antivirus-firewall-antispyware': { product: 'gerador', before: 'Perguntas frequentes', label: 'Praticar mais questões de Segurança' },
  'perifericos-entrada-saida-concurso': { product: 'gerador', before: 'Conclusão', label: 'Praticar mais questões de Hardware' },
  'fonte-de-alimentacao-nobreak-estabilizador-concursos': { product: 'gerador', before: 'Conclusão', label: 'Praticar mais questões de Hardware' },
};
const showQuizOffer = Astro.props.slug.startsWith('simulado-');
const offer = articleOffers[Astro.props.slug];
const sections = headings.filter((heading) => heading.depth === 2);
const readingSections = sections.length >= 3 ? sections : headings.filter((heading) => heading.depth === 3);
const offerBefore = offer
  ? sections.find((heading) => heading.text.startsWith(offer.before))?.slug
  : readingSections.length >= 3 ? readingSections[Math.floor(readingSections.length / 2)]?.slug : undefined;

const formattedDate = date.toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

// "Atualizado em" só aparece quando o artigo foi editado em um dia depois da publicação.
const formattedUpdated = updated?.toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const showUpdated = !!formattedUpdated && formattedUpdated !== formattedDate && updated!.getTime() > date.getTime();

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image: image ? [new URL(image.src, Astro.site).toString()] : undefined,
  keywords: tags?.join(", "),
  articleSection: category,
  inLanguage: "pt-BR",
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  author: {
    '@type': 'Person',
    name: 'Fernando Lisboa',
    url: new URL('/sobre-nos', Astro.site).toString(),
  },
  publisher: {
    '@type': 'Organization',
    name: 'Informática para Concurso',
    logo: {
      '@type': 'ImageObject',
      url: new URL('/images/logo.png', Astro.site).toString(),
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(Astro.url.pathname, Astro.site).toString(),
  },
};


const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: category, item: new URL(categoryHref(category), Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: title },
  ],
};
---
<BaseLayout title={title} seoTitle={seoTitle} description={description} image={image?.src} type="article" published={date} modified={updated ?? date}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <ReadingProgress />
  <div class="container post-shell">
    <article class="post">
      <header class="post-head">
        <nav class="crumbs" aria-label="Você está em">
          <a href="/">Início</a>
          <span aria-hidden="true">/</span>
          <a href={categoryHref(category)}>{category}</a>
        </nav>
        <a class="pill" href={categoryHref(category)} style={`--cat:${categoryColor(category)}`}>{category}</a>
        <h1>{title}</h1>
        <p class="meta">
          <span>Por <a href="/sobre-nos">Fernando Lisboa</a></span>
          <span><time datetime={date.toISOString()}>{formattedDate}</time></span>
          {showUpdated && <span>Atualizado em <time datetime={updated!.toISOString()}>{formattedUpdated}</time></span>}
          {readingTime && <span>{readingTime} de leitura</span>}
          {quiz && quiz.questions.length > 0 && <a class="qchip" href="#questoes">{quiz.questions.length} questões</a>}
        </p>
        <ShareButtons title={title} />

        {image && (
          <div class="hero-image">
            <Image src={image} alt={imageAlt ?? title} width={1200} height={800} widths={[600, 900, 1200]} sizes="(max-width: 820px) 100vw, 760px" quality={72} priority />
          </div>
        )}

        <TableOfContents headings={headings} />
      </header>

      <div class="post-body">
        <div class="prose">
          <slot />
        </div>

        {!showQuizOffer && (
          <div data-article-offer={offerBefore ?? ''}>
            <StudyOffer product={offer?.product ?? 'gerador'} placement="artigo-entre-secoes" label={offer?.label} />
          </div>
        )}

        {quiz && (
          <Quiz questions={quiz.questions} mode={quiz.mode} title={quiz.title}>
            {showQuizOffer && <StudyOffer slot="result-offer" product="gerador" placement="simulado-resultado" />}
          </Quiz>
        )}

        <AuthorBio />

        <ShareButtons title={title} variant="end" />
        <RelatedPosts slug={Astro.props.slug} category={category} tags={tags} related={related} />
      </div>
    </article>
    <div class="post-rail rail-left">
      <StudyOffer product="apostila" placement="artigo-lateral-esquerda" format="rail" label="Ver amostra" />
    </div>
    <div class="post-rail rail-right">
      <StudyOffer product="gerador" placement="artigo-lateral-direita" format="rail" label="Montar meu treino" />
    </div>

  </div>
  <GeneratorAnchor />
</BaseLayout>

<script>
  const articleOffer = document.querySelector<HTMLElement>('[data-article-offer]');
  const offerBefore = articleOffer?.dataset.articleOffer;
  if (articleOffer && offerBefore) document.getElementById(offerBefore)?.before(articleOffer);

  function legacyCopy(text: string): boolean {
    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.appendChild(textarea);
    textarea.select();
    let ok = false;
    try {
      ok = document.execCommand('copy');
    } catch {
      ok = false;
    }
    document.body.removeChild(textarea);
    return ok;
  }

  // The markdown tables only contain the text "📋 Copiar"; turn those cells into working copy buttons.
  function setupCopyButtons() {
    let uid = 0;
    const makeButton = (label: string, targetId: string) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'copy-btn';
      btn.dataset.copyTarget = targetId;
      btn.textContent = label;
      return btn;
    };

    document.querySelectorAll<HTMLTableElement>('.prose table').forEach((table) => {
      const headers = Array.from(table.querySelectorAll('thead th'));
      let cmdCol = headers.findIndex((th) => /comando|c[oó]digo/i.test(th.textContent ?? ''));
      const rows = Array.from(table.querySelectorAll<HTMLTableRowElement>('tbody tr'));
      const commands: string[] = [];

      rows.forEach((row) => {
        const cells = Array.from(row.children) as HTMLElement[];
        const actionCell = cells.find((c) => c.tagName === 'TD' && (c.textContent ?? '').trim() === '📋 Copiar');
        if (!actionCell) return;
        if (cmdCol < 0 || !cells[cmdCol]) cmdCol = cells.findIndex((c) => c.querySelector('code'));
        const cmdCell = cells[cmdCol];
        if (!cmdCell) return;
        const id = 'copy-cmd-' + uid++;
        cmdCell.id = id;
        commands.push((cmdCell.textContent ?? '').trim());
        actionCell.textContent = '';
        actionCell.appendChild(makeButton('📋 Copiar', id));
      });

      // "📋 Copiar todos os N" paragraph right before the table
      const prev = table.previousElementSibling;
      if (prev && prev.tagName === 'P' && /^📋\s*Copiar todos/i.test((prev.textContent ?? '').trim()) && commands.length) {
        const all = document.createElement('pre');
        all.id = 'copy-all-' + uid++;
        all.hidden = true;
        all.textContent = commands.join('\n');
        const label = (prev.textContent ?? '').trim();
        prev.textContent = '';
        prev.appendChild(makeButton(label, all.id));
        prev.appendChild(all);
      }
    });
  }

  setupCopyButtons();

  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.copy-btn');
    if (!button) return;

    const targetId = button.dataset.copyTarget;
    const target = targetId && document.getElementById(targetId);
    if (!target) return;

    const text = target.textContent?.trim() ?? '';
    const original = button.textContent;

    const showFeedback = (label: string, isError: boolean) => {
      button.textContent = label;
      button.classList.toggle('copied', !isError);
      button.classList.toggle('copy-error', isError);
      setTimeout(() => {
        button.textContent = original;
        button.classList.remove('copied', 'copy-error');
      }, 1500);
    };

    if (navigator.clipboard?.writeText) {
      navigator.clipboard.writeText(text).then(
        () => showFeedback('Copiado!', false),
        () => {
          const ok = legacyCopy(text);
          showFeedback(ok ? 'Copiado!' : 'Use Ctrl+C', !ok);
        },
      );
    } else {
      const ok = legacyCopy(text);
      showFeedback(ok ? 'Copiado!' : 'Use Ctrl+C', !ok);
    }
  });
</script>

<style>
  /* Coluna única de leitura: capa 1200x800 (3:2), guia logo abaixo e o texto. */
  .post-shell {
    max-width: 808px;
    padding-block: 32px 56px;
  }
  .post-rail { display: none; }

  @media (min-width: 1280px) and (min-height: 590px) {
    .post-shell {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 760px) minmax(0, 1fr);
      column-gap: 24px;
      max-width: 1320px;
    }
    .post-shell > article { grid-area: 1 / 2; min-width: 0; }
    .post-rail { display: block; position: sticky; top: 96px; align-self: start; }
    .rail-left { grid-area: 1 / 1; }
    .rail-right { grid-area: 1 / 3; }
  }

  .post-head,
  .post-body {
    min-width: 0;
  }


  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    margin: 0 0 24px;
    font-size: 0.875rem;
    color: var(--ink-soft);
  }

  .crumbs a {
    color: var(--ink-soft);
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--ink-strong);
  }

  .pill {
    display: inline-block;
    margin-bottom: 20px;
    padding: 4px 12px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--cat) 40%, transparent);
    color: var(--cat);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
  }

  :global(:root[data-theme='light']) .pill {
    color: color-mix(in srgb, var(--cat) 55%, #000);
  }

  h1 {
    font-size: clamp(2.125rem, 4.6vw, 3.375rem);
    font-weight: 800;
    letter-spacing: -0.022em;
    line-height: 1.08;
    margin-bottom: 20px;
    text-wrap: balance;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
    color: var(--ink-soft);
    font-size: 0.875rem;
    margin: 0 0 24px;
  }

  .meta a {
    color: var(--ink-strong);
    text-decoration: none;
    font-weight: 600;
  }

  .meta a:hover {
    text-decoration: underline;
  }

  .meta .qchip {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--chip-ink);
  }

  /* Capa na largura da coluna, 3:2 como o padrão 1200x800. */
  .hero-image {
    aspect-ratio: 3 / 2;
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    margin: 28px 0 28px;
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  :global(.prompt-card) {
    margin: 24px 0;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 16px 32px -20px rgba(91, 33, 182, 0.35);
  }

  :global(.prompt-card-bar) {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    background: var(--ink-deep);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  :global(.prompt-card-bar .dot) {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }

  :global(.prompt-card-bar .dot-red) {
    background: #ff5f56;
  }

  :global(.prompt-card-bar .dot-yellow) {
    background: #ffbd2e;
  }

  :global(.prompt-card-bar .dot-green) {
    background: #27c93f;
  }

  :global(.prompt-card-label) {
    margin-left: 4px;
    flex: 1;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.45);
  }

  :global(.copy-btn) {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.78rem;
    padding: 5px 12px;
    border-radius: 5px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(255, 255, 255, 0.06);
    color: #ece7fb;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  :global(.copy-btn:hover) {
    border-color: var(--teal-soft);
    color: var(--teal-soft);
  }

  :global(.copy-btn.copied) {
    background: var(--teal);
    border-color: var(--teal);
    color: #ffffff;
  }

  :global(.copy-btn.copy-error) {
    background: var(--rose);
    border-color: var(--rose);
    color: #ffffff;
  }

  :global(.prompt-card pre) {
    margin: 0;
    border-radius: 0;
  }
</style>
