---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import BackToTop from '../components/BackToTop.astro';
import { Font } from 'astro:assets';
import '../styles/global.css';

interface Props {
  title: string;
  seoTitle?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  published?: Date;
  modified?: Date;
  showSiteNavigation?: boolean;
  footerOffer?: 'apostila' | 'gerador';
}

const {
  title,
  seoTitle,
  description ='Resumos, simulados e o que cai na prova de informática dos concursos, em linguagem simples e direta.',
  image = '/images/og-default.webp',
  type = 'website',
  noindex = false,
  published,
  modified,
  showSiteNavigation = true,
  footerOffer,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
const siteName = 'Informática para Concurso';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteName,
  url: Astro.site,
  logo: new URL('/images/logo.png', Astro.site).toString(),
};
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <script is:inline>
      const storedTheme = localStorage.getItem('theme');
      if (storedTheme === 'dark' || storedTheme === 'light') {
        document.documentElement.setAttribute('data-theme', storedTheme);
      }
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-adsense-account" content="ca-pub-1196503092730158" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
    <meta name="google-site-verification" content="X0WtOXNS9hrK5eG-BF29jRIgMf6yj20Xu1gEDDW6Whc" />

    <script is:inline>
      // Consent: EU/UK-style timezones start denied (opt-in); everywhere else starts granted (opt-out).
      // The visitor's choice is stored in localStorage under "cookie-consent".
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      (function () {
        var tz = '';
        try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) {}
        var strict = tz.indexOf('Europe/') === 0 ||
          ['Atlantic/Canary','Atlantic/Madeira','Atlantic/Azores','Atlantic/Faroe','Atlantic/Reykjavik','Asia/Nicosia','Asia/Famagusta'].indexOf(tz) !== -1;
        var stored = null;
        try { stored = localStorage.getItem('cookie-consent'); } catch (e) {}
        var state = (stored === 'granted' || stored === 'denied') ? stored : (strict ? 'denied' : 'granted');
        gtag('consent', 'default', {
          analytics_storage: state, ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied'
        });
        gtag('js', new Date());
        gtag('config', 'G-0JD2BJEBBS');

        // Load Analytics once, when the page finishes loading or at the first interaction.
        var analyticsLoaded = false;
        function loadAnalytics() {
          if (analyticsLoaded) return;
          analyticsLoaded = true;
          var g = document.createElement('script');
          g.async = true;
          g.src = 'https://www.googletagmanager.com/gtag/js?id=G-0JD2BJEBBS';
          document.head.appendChild(g);
        }
        ['pointerdown', 'keydown', 'scroll', 'touchstart'].forEach(function (ev) {
          window.addEventListener(ev, loadAnalytics, { once: true, passive: true });
        });
        window.addEventListener('load', loadAnalytics, { once: true });

        window.siteConsent = {
          hasChoice: function () { return stored === 'granted' || stored === 'denied'; },
          set: function (value) {
            stored = value;
            try { localStorage.setItem('cookie-consent', value); } catch (e) {}
            gtag('consent', 'update', { analytics_storage: value });
          }
        };
      })();
    </script>
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title={siteName} href={new URL('/rss.xml', Astro.site)} />
    <title>{seoTitle ?? `${title} · ${siteName}`}</title>

    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={seoTitle ?? title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    {type === 'article' && <meta property="og:image:width" content="1200" />}
    {type === 'article' && <meta property="og:image:height" content="800" />}
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <meta property="og:url" content={canonicalURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle ?? title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

    <Font cssVariable="--f-inter" preload />
    <Font cssVariable="--f-archivo" preload />
    <Font cssVariable="--f-jetbrains-mono" />
    <Font cssVariable="--f-lexend" />

  </head>
  <body>
    {showSiteNavigation && <a class="skip-link" href="#main-content">Pular para o conteúdo</a>}
    {showSiteNavigation && <Header />}
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    {showSiteNavigation && <Footer product={footerOffer} />}
    <BackToTop />
    <CookieBanner />
  </body>
</html>

<script>
  declare const gtag: (...args: unknown[]) => void;

  const send = (event: string, banner: HTMLElement) => {
    if (typeof gtag === 'function') gtag('event', event, { banner_id: banner.dataset.banner, slot: banner.dataset.slot });
  };

  const banners = document.querySelectorAll<HTMLElement>('[data-banner][data-slot]');
  if (banners.length && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.intersectionRatio < 0.5) continue;
        send('banner_view', entry.target as HTMLElement);
        observer.unobserve(entry.target);
      }
    }, { threshold: 0.5 });
    banners.forEach((banner) => observer.observe(banner));
  }
  banners.forEach((banner) => {
    banner.querySelector('[data-banner-link]')?.addEventListener('click', () => send('banner_click', banner));
  });
</script>
